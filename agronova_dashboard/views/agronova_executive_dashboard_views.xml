<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Rahbar paneli — OWL mijoz amali.
            Ko'rinish `static/src/dashboard/` da (dashboard.js / .xml / .scss),
            ma'lumot esa `agronova.executive.dashboard.get_dashboard_data()` dan keladi.
        -->
        <record id="action_agronova_executive_dashboard_panel" model="ir.actions.client">
            <field name="name">Rahbar paneli</field>
            <field name="tag">agronova_executive_dashboard</field>
        </record>

        <!-- Yem zavodi ilovasidan ochilganda panel darhol shu bo'limda turadi. -->
        <record id="action_agronova_dashboard_yem" model="ir.actions.client">
            <field name="name">Yem zavodi — boshqaruv paneli</field>
            <field name="tag">agronova_executive_dashboard</field>
            <field name="context">{'agronova_section': 'yem_zavodi'}</field>
        </record>

        <menuitem id="menu_agronova_dashboard_yem" name="Boshqaruv paneli"
                  parent="agronova_yem_zavodi.menu_yem_root" sequence="5"
                  action="action_agronova_dashboard_yem"
                  groups="agronova_dashboard.group_agronova_dashboard_user"/>

    </data>
</odoo>
