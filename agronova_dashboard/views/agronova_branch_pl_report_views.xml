<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_agronova_branch_pl_report_list" model="ir.ui.view">
            <field name="name">agronova.branch.pl.report.list</field>
            <field name="model">agronova.branch.pl.report</field>
            <field name="arch" type="xml">
                <list string="Filiallar P&amp;L konsolidatsiyasi" create="0" edit="0" delete="0">
                    <field name="oy"/>
                    <field name="sektor_nomi"/>
                    <field name="daromad_tushum" widget="monetary" sum="Jami Daromad"/>
                    <field name="xarajat_jami" widget="monetary" sum="Jami Xarajat"/>
                    <field name="sof_foyda" widget="monetary" sum="Jami Sof Foyda"/>
                    <field name="rentabellik_foiz" widget="percentage"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_agronova_branch_pl_report_pivot" model="ir.ui.view">
            <field name="name">agronova.branch.pl.report.pivot</field>
            <field name="model">agronova.branch.pl.report</field>
            <field name="arch" type="xml">
                <pivot string="Filiallar P&amp;L Pivot Tahlili" sample="1">
                    <field name="sektor_nomi" type="row"/>
                    <field name="oy" type="col"/>
                    <field name="daromad_tushum" type="measure"/>
                    <field name="xarajat_jami" type="measure"/>
                    <field name="sof_foyda" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_agronova_branch_pl_report_graph" model="ir.ui.view">
            <field name="name">agronova.branch.pl.report.graph</field>
            <field name="model">agronova.branch.pl.report</field>
            <field name="arch" type="xml">
                <graph string="Filiallar Foyda-Zarar Grafigi" type="bar" sample="1">
                    <field name="sektor_nomi"/>
                    <field name="sof_foyda" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_agronova_branch_pl_report_search" model="ir.ui.view">
            <field name="name">agronova.branch.pl.report.search</field>
            <field name="model">agronova.branch.pl.report</field>
            <field name="arch" type="xml">
                <search string="P&amp;L Qidiruvi">
                    <field name="sektor_nomi"/>
                    <field name="oy"/>
                    <group>
                        <filter string="Filial bo'yicha" name="group_sektor" context="{'group_by': 'sektor_nomi'}"/>
                        <filter string="Oy bo'yicha" name="group_oy" context="{'group_by': 'oy'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_agronova_branch_pl_report" model="ir.actions.act_window">
            <field name="name">📈 Filiallar konsolidatsiyalangan P&amp;L</field>
            <field name="res_model">agronova.branch.pl.report</field>
            <field name="view_mode">pivot,graph,list</field>
            <field name="context">{'search_default_group_sektor': 1}</field>
        </record>

    </data>
</odoo>
