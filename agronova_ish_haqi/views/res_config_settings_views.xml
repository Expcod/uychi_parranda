<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_ih" model="ir.ui.view">
        <field name="name">res.config.settings.agronova.ish.haqi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="before">
                <block title="Ish haqi" name="agronova_ish_haqi">
                    <setting string="Provodka hisob raqamlari"
                             help="Ish haqi tasdiqlanganda: Dt xarajat / Kt xodimga qarz. Bosh buxgalter tasdiqlashi kerak.">
                        <field name="agronova_ish_haqi_account_xarajat"/>
                        <field name="agronova_ish_haqi_account_qarz"/>
                        <field name="agronova_ish_haqi_journal"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
