    <!-- ===================================================== OBXOD -->

    <record id="rule_boquv_obxod_ishchi" model="ir.rule">
        <field name="name">Boquv: ishchi faqat o'z obxodlari</field>
        <field name="model_id" ref="model_agronova_boquv_obxod"/>
        <field name="domain_force">
            ['|', ('brigadir_id.user_id', '=', user.id),
