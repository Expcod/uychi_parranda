    <record id="rule_boquv_jurnal_ishchi" model="ir.rule">
        <field name="name">Boquv: ishchi faqat o'z binosi jurnali</field>
        <field name="model_id" ref="model_agronova_boquv_jurnal"/>
        <field name="domain_force">
            ['|', ('bino_id.operator_id.user_id', '=', user.id),
                  ('bino_id.brigadir_id.user_id', '=', user.id)]
