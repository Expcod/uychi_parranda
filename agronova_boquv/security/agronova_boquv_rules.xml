        <field name="domain_force">
            ['|', ('filial_id.boshliq_id.user_id', '=', user.id),
                  ('create_uid', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_boquv_brigadir'))]"/>
    </record>

    <record id="rule_boquv_xarajat_boshliq" model="ir.rule">
        <field name="name">Boquv: boshliq barcha xarajatlarni ko'radi</field>
        <field name="model_id" ref="model_agronova_boquv_xarajat"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_boquv_boshliq'))]"/>
    </record>

</odoo>
