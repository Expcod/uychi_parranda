<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================== ISH HAQI -->

    <record id="view_boquv_ish_haqi_list" model="ir.ui.view">
        <field name="name">agronova.boquv.ish_haqi.list</field>
        <field name="model">agronova.boquv.ish_haqi</field>
        <field name="arch" type="xml">
            <list string="Ish haqi taqsimoti"
                  decoration-muted="holat == 'storno'">
                <field name="name"/>
                <field name="davr_boshi"/>
                <field name="davr_oxiri"/>
                <field name="filial_id" optional="show"/>
                <field name="xodim_soni"/>
                <field name="jami_summa" sum="Jami"/>
                <field name="holat" widget="badge"
                       decoration-success="holat == 'posted'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_boquv_ish_haqi_form" model="ir.ui.view">
        <field name="name">agronova.boquv.ish_haqi.form</field>
        <field name="model">agronova.boquv.ish_haqi</field>
        <field name="arch" type="xml">
            <form string="Ish haqi taqsimoti">
                <header>
                    <button name="action_yigish" type="object"
                            string="Yig'ish" class="btn-secondary"
                            invisible="holat != 'draft'"/>
                    <button name="action_tasdiqlash" type="object"
                            string="Tasdiqlash" class="btn-primary"
                            invisible="holat != 'draft'"/>
                    <button name="action_storno" type="object"
                            string="Storno" invisible="holat != 'posted'"
                            confirm="Storno qilinganda barcha analitik qatorlar teskari yoziladi. Davom etasizmi?"/>
                    <button name="action_qoralamaga" type="object"
                            string="Qoralamaga" invisible="holat != 'storno'"/>
                    <field name="holat" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Davr">
                            <field name="davr_boshi"/>
                            <field name="davr_oxiri"/>
                            <field name="filial_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Qamrov">
                            <field name="department_ids"
                                   widget="many2many_tags"/>
                            <field name="xodim_soni"/>
                            <field name="jami_summa"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        <b>Binoga biriktirilgan</b> xodim (operator) — ish haqi
                        to'g'ridan-to'g'ri o'sha binoning faol partiyalariga.
                        <b>Biriktirilmagan</b> (brigadir, oshpaz) — m² bo'yicha.
                        Xodim kartochkasida «Faqat aktiv binolarga» belgilangan
                        bo'lsa (veterinar), dizinfeksiyadagi binoga tushmaydi.
                    </div>
                    <notebook>
                        <page string="Taqsimot qatorlari" name="qatorlar">
                            <field name="qator_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="bino_id"/>
                                    <field name="filial_id" optional="show"/>
                                    <field name="usul"/>
                                    <field name="kunlar"/>
                                    <field name="jami_kun" optional="hide"/>
                                    <field name="oylik_summa" optional="show"/>
                                    <field name="ulush" sum="Jami ulush"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Analitik qatorlar" name="analitik"
                              invisible="holat == 'draft'">
                            <field name="analytic_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Izoh" name="izoh">
                            <field name="izoh"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_boquv_ish_haqi" model="ir.actions.act_window">
        <field name="name">Ish haqi taqsimoti</field>
        <field name="res_model">agronova.boquv.ish_haqi</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Oylik taqsimotni yarating</p>
            <p>
                Davr tanlanadi, «Yig'ish» bosiladi — tizim xodimlarni topib
                ish haqini binolarga bo'ladi. Tasdiqlanganda xarajat
                partiyalarning analitik hisobiga tushadi va tannarxga kiradi.
            </p>
        </field>
    </record>

    <!-- ================================================ DEZINFEKSIYA -->

    <record id="view_boquv_dezinfeksiya_list" model="ir.ui.view">
        <field name="name">agronova.boquv.dezinfeksiya.list</field>
        <field name="model">agronova.boquv.dezinfeksiya</field>
        <field name="arch" type="xml">
            <list string="Dezinfeksiya" decoration-muted="holat == 'draft'">
                <field name="name"/>
                <field name="sana"/>
                <field name="bino_id"/>
                <field name="filial_id" optional="show"/>
                <field name="vosita_qiymat" sum="Vositalar"/>
                <field name="ishchi_kun" optional="show"/>
                <field name="mehnat_qiymat" sum="Mehnat"/>
                <field name="boshqa_qiymat" optional="hide"/>
                <field name="jami_summa" sum="Jami"/>
                <field name="partiya_id" optional="show"/>
                <field name="holat" widget="badge"
                       decoration-success="holat == 'biriktirilgan'"
                       decoration-info="holat == 'done'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_boquv_dezinfeksiya_form" model="ir.ui.view">
        <field name="name">agronova.boquv.dezinfeksiya.form</field>
        <field name="model">agronova.boquv.dezinfeksiya</field>
        <field name="arch" type="xml">
            <form string="Dezinfeksiya">
                <header>
                    <button name="action_tasdiqlash" type="object"
                            string="Tasdiqlash" class="btn-primary"
                            invisible="holat != 'draft'"/>
                    <button name="action_partiyaga_biriktirish" type="object"
                            string="Partiyaga biriktirish" class="btn-primary"
                            invisible="holat != 'done'"/>
                    <button name="action_storno" type="object"
                            string="Storno" invisible="holat == 'draft'"/>
                    <field name="holat" widget="statusbar"
                           statusbar_visible="draft,done,biriktirilgan"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Asosiy">
                            <field name="sana"/>
                            <field name="bino_id"/>
                            <field name="filial_id" readonly="1"/>
                            <field name="mas_ul_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Mehnat va boshqa">
                            <field name="ishchi_kun"/>
                            <field name="ishchi_kun_narx"/>
                            <field name="mehnat_qiymat"/>
                            <field name="boshqa_qiymat"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status"
                         invisible="holat == 'biriktirilgan'">
                        Dezinfeksiya xarajati partiyadan <b>oldin</b> sodir
                        bo'ladi, lekin TZ bo'yicha <b>keyingi partiyaga</b>
                        biriktiriladi. Tasdiqlanganda xarajat binoda turadi,
                        partiya ochilganda unga avtomat ko'chadi.
                    </div>
                    <div class="alert alert-success" role="status"
                         invisible="holat != 'biriktirilgan'">
                        Xarajat <field name="partiya_id" readonly="1"
                                       class="oe_inline"/> partiyasiga
                        ko'chirilgan.
                    </div>
                    <notebook>
                        <page string="Ishlatilgan vositalar" name="sarf">
                            <field name="sarf_ids"
                                   readonly="holat != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="miqdor"/>
                                    <field name="uom_id"
                                           options="{'no_create': True}"/>
                                    <field name="qiymat" readonly="1"
                                           sum="Jami qiymat"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="vosita_qiymat"/>
                                <field name="mehnat_qiymat"/>
                                <field name="boshqa_qiymat"/>
                                <field name="jami_summa"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Izoh" name="izoh">
                            <field name="izoh"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_boquv_dezinfeksiya" model="ir.actions.act_window">
        <field name="name">Dezinfeksiya</field>
        <field name="res_model">agronova.boquv.dezinfeksiya</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Birinchi hujjatni kiriting</p>
            <p>
                Yangi partiyadan oldin bino dezinfeksiya qilinadi. Vosita va
                ishchi mehnati xarajati <b>keyingi partiyaga</b> biriktiriladi.
            </p>
        </field>
    </record>

    <!-- ===================================================== O'TKAZMA -->

    <record id="view_boquv_otkazma_list" model="ir.ui.view">
        <field name="name">agronova.boquv.otkazma.list</field>
        <field name="model">agronova.boquv.otkazma</field>
        <field name="arch" type="xml">
            <list string="O'tkazmalar" decoration-muted="holat == 'draft'">
                <field name="name"/>
                <field name="sana"/>
                <field name="sabab"/>
                <field name="manba_partiya_id"/>
                <field name="manba_bino_id" optional="show"/>
                <field name="qabul_partiya_id"/>
                <field name="qabul_bino_id" optional="show"/>
                <field name="bosh_soni" sum="Jami bosh"/>
                <field name="tannarx_summa" sum="Jami tannarx"/>
                <field name="holat" widget="badge"
                       decoration-success="holat == 'done'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_boquv_otkazma_form" model="ir.ui.view">
        <field name="name">agronova.boquv.otkazma.form</field>
        <field name="model">agronova.boquv.otkazma</field>
        <field name="arch" type="xml">
            <form string="Partiyalararo o'tkazma">
                <header>
                    <button name="action_otkazish" type="object"
                            string="O'tkazish" class="btn-primary"
                            invisible="holat != 'draft'"/>
                    <button name="action_storno" type="object"
                            string="Storno" invisible="holat != 'done'"/>
                    <field name="holat" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Manba">
                            <field name="sana"/>
                            <field name="sabab"/>
                            <field name="manba_partiya_id"/>
                            <field name="manba_bino_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Qabul qiluvchi">
                            <field name="qabul_partiya_id"/>
                            <field name="qabul_bino_id" readonly="1"/>
                            <field name="mas_ul_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Miqdor">
                            <field name="bosh_soni"/>
                            <field name="ortacha_vazn"/>
                        </group>
                        <group string="Tannarx">
                            <field name="tannarx_summa"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        O'tkazilgan boshlar <b>tannarxini o'zi bilan olib
                        ketadi</b>: manba partiyada tannarx chiqadi, qabul
                        qiluvchida kiradi. O'tkazma daromad ham, zarar ham
                        keltirmaydi — faqat ichki ko'chirish.
                    </div>
                    <group string="Izoh">
                        <field name="izoh" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_boquv_otkazma" model="ir.actions.act_window">
        <field name="name">Partiyalararo o'tkazma</field>
        <field name="res_model">agronova.boquv.otkazma</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">O'tkazma yarating</p>
            <p>
                Jo'jani bir binodan boshqasiga ko'chirish: siyraklashtirish,
                qoldiqlarni birlashtirish yoki saralash uchun.
            </p>
        </field>
    </record>

    <!-- ================================ XODIM KARTOCHKASI KENGAYTMASI -->

    <record id="view_boquv_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.boquv</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- `job_id` dan keyin qo'yamiz — Ona Tovuq ham shunday qiladi.
                 Guruh (`<group>`) qo'shish o'rniga alohida maydonlar:
                 hr formasining tuzilmasi versiyadan versiyaga o'zgaradi,
                 maydonga langar tashlash barqarorroq. -->
            <field name="job_id" position="after">
                <field name="agronova_boquv_filial_id"
                       groups="agronova_boquv.group_boquv_boshliq"/>
                <field name="agronova_boquv_bino_id"
                       groups="agronova_boquv.group_boquv_boshliq"/>
                <field name="agronova_boquv_faqat_aktiv"
                       groups="agronova_boquv.group_boquv_boshliq"/>
            </field>
        </field>
    </record>

</odoo>
