<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_boquv_partiya_list" model="ir.ui.view">
        <field name="name">agronova.boquv.partiya.list</field>
        <field name="model">agronova.boquv.partiya</field>
        <field name="arch" type="xml">
            <list string="Boquv partiyalari"
                  decoration-success="holat == 'active'"
                  decoration-muted="holat in ('closed', 'cancel')"
                  decoration-danger="ogish_bormi">
                <field name="name"/>
                <field name="filial_id"/>
                <field name="bino_id"/>
                <field name="ochilish_sana"/>
                <field name="joja_sana" optional="show"/>
                <field name="yosh_kun"/>
                <field name="boshlangich_son" sum="Jami boshlang'ich"/>
                <field name="joriy_son" sum="Jami tirik"/>
                <field name="nobud_foiz" widget="percentage"/>
                <field name="ortacha_vazn" optional="show"/>
                <field name="fcr" optional="show"/>
                <field name="epef" optional="hide"/>
                <field name="tannarx_1_bosh"/>
                <field name="tannarx_1_kg" optional="show"/>
                <field name="foyda" optional="hide"/>
                <field name="ogish_bormi" column_invisible="1"/>
                <field name="holat" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_boquv_partiya_form" model="ir.ui.view">
        <field name="name">agronova.boquv.partiya.form</field>
        <field name="model">agronova.boquv.partiya</field>
        <field name="arch" type="xml">
            <form string="Boquv partiyasi">
                <header>
                    <button name="action_ochish" type="object"
                            string="Partiyani ochish" class="btn-primary"
                            invisible="holat != 'draft'"/>
                    <button name="action_faollashtirish" type="object"
                            string="Faollashtirish" class="btn-primary"
                            invisible="holat != 'kutilmoqda'"/>
                    <button name="action_close" type="object"
                            string="Partiyani yopish" class="btn-primary"
                            invisible="holat != 'active'"
                            confirm="Partiya yopilgach tannarx qotadi va unga yangi yozuv qo'shilmaydi. Davom etasizmi?"/>
                    <button name="action_bekor" type="object"
                            string="Bekor qilish"
                            invisible="holat in ('closed', 'cancel')"
                            confirm="Bekor qilinganda yig'ilgan xarajat davr zarariga o'tadi. Davom etasizmi?"/>
                    <button name="action_draftga" type="object"
                            string="Qoralamaga"
                            invisible="holat != 'kutilmoqda'"/>
                    <field name="holat" widget="statusbar"
                           statusbar_visible="draft,kutilmoqda,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_jurnal" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="jurnal_count" widget="statinfo"
                                   string="Jurnal kunlari"/>
                        </button>
                        <button name="action_open_obxod" type="object"
                                class="oe_stat_button" icon="fa-eye">
                            <field name="obxod_bugun_soni" widget="statinfo"
                                   string="Bugungi obxod"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="not ogish_bormi">
                        <b>Normadan og'ish aniqlandi.</b>
                        FCR <field name="fcr" readonly="1" class="oe_inline"/>
                        (norma <field name="fcr_norma" readonly="1" class="oe_inline"/>),
                        nobudgarchilik
                        <field name="nobud_foiz" readonly="1" class="oe_inline"/>%
                        (norma <field name="nobud_norma" readonly="1" class="oe_inline"/>%).
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="ortiqcha_kutish_kun == 0">
                        Jo'ja <field name="kutish_kun" readonly="1" class="oe_inline"/>
                        kun kutildi. Normadan ortiq
                        <field name="ortiqcha_kutish_kun" readonly="1" class="oe_inline"/>
                        kunning doimiy xarajati <b>«bo'sh turish zarari»</b>
                        hisobiga o'tadi.
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="obxod_bugun_soni >= 3 or holat != 'active'">
                        Bugun <field name="obxod_bugun_soni" readonly="1"
                                     class="oe_inline"/> marta obxod qilingan.
                        Norma — kuniga kamida <b>3 marta</b>.
                    </div>

                    <group>
                        <group string="Joylashuvi">
                            <field name="filial_id"
                                   readonly="holat != 'draft'"/>
                            <field name="bino_id"
                                   readonly="holat != 'draft'"/>
                            <field name="brigadir_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Muddat">
                            <field name="ochilish_sana"
                                   readonly="holat not in ('draft', 'kutilmoqda')"/>
                            <field name="joja_sana"
                                   readonly="holat in ('closed', 'cancel')"/>
                            <field name="reja_kun"/>
                            <field name="yosh_kun"/>
                            <field name="kutish_kun"/>
                            <field name="yopilish_sana"
                                   invisible="holat != 'closed'"/>
                        </group>
                    </group>

                    <group>
                        <group string="Bosh soni">
                            <field name="boshlangich_son" readonly="1"/>
                            <field name="nobud_son"/>
                            <field name="chiqim_son"/>
                            <field name="joriy_son"/>
                            <field name="nobud_foiz" widget="percentage"/>
                            <field name="yashovchanlik" widget="percentage"/>
                        </group>
                        <group string="Vazn va samaradorlik">
                            <field name="boshlangich_vazn"/>
                            <field name="ortacha_vazn"/>
                            <field name="jami_tirik_vazn"/>
                            <field name="kunlik_osish_gr"/>
                            <field name="yem_sarf_kg"/>
                            <field name="fcr"/>
                            <field name="epef"/>
                        </group>
                    </group>

                    <group string="Tannarx (qo'lda kiritilmaydi)">
                        <group>
                            <field name="jami_xarajat"/>
                            <field name="tannarx_1_bosh"/>
                            <field name="tannarx_1_kg"/>
                            <field name="tannarx_qotgan"/>
                        </group>
                        <group>
                            <field name="jami_daromad"/>
                            <field name="foyda"/>
                            <field name="rentabellik" widget="percentage"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Jo'ja kirimi" name="kirim">
                            <field name="kirim_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="sana"/>
                                    <field name="manba"/>
                                    <field name="dona" sum="Jami bosh"/>
                                    <field name="birlik_narx"/>
                                    <field name="summa" sum="Jami summa"/>
                                    <field name="holat" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Kunlik jurnal" name="jurnal">
                            <field name="jurnal_ids" readonly="1">
                                <list>
                                    <field name="sana"/>
                                    <field name="kun_boshi_son"/>
                                    <field name="nobud_son" sum="Jami nobud"/>
                                    <field name="nobud_sabab"/>
                                    <field name="kun_oxiri_son"/>
                                    <field name="yem_kg" sum="Jami yem (kg)"/>
                                    <field name="sarf_qiymat" sum="Jami qiymat"/>
                                    <field name="holat" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vazn nazorati" name="vazn">
                            <field name="vazn_ids" readonly="1">
                                <list>
                                    <field name="sana"/>
                                    <field name="yosh_kun"/>
                                    <field name="tortilgan_son"/>
                                    <field name="ortacha_vazn"/>
                                    <field name="min_vazn"/>
                                    <field name="max_vazn"/>
                                    <field name="bir_xillik"/>
                                    <field name="jami_tirik_vazn"/>
                                    <field name="vazn_ogish"/>
                                </list>
                            </field>
                        </page>
                        <page string="Obxodlar" name="obxod">
                            <field name="obxod_ids" readonly="1">
                                <list>
                                    <field name="vaqt"/>
                                    <field name="brigadir_id"/>
                                    <field name="harorat"/>
                                    <field name="harorat_holati" widget="badge"
                                           decoration-danger="harorat_holati in ('past', 'yuqori')"
                                           decoration-success="harorat_holati == 'normal'"/>
                                    <field name="jojalar_holati"/>
                                    <field name="yem_holati"/>
                                    <field name="suv_holati"/>
                                    <field name="muammo"/>
                                </list>
                            </field>
                        </page>
                        <page string="So'yimga jo'natma" name="jonatma">
                            <field name="jonatma_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="sana"/>
                                    <field name="tur"/>
                                    <field name="bosh_soni" sum="Jami bosh"/>
                                    <field name="jonatilgan_vazn" sum="Jo'natilgan kg"/>
                                    <field name="qabul_vazn" sum="Qabul kg"/>
                                    <field name="yol_yoqotish_foiz"/>
                                    <field name="yoqotish_holati" widget="badge"
                                           decoration-danger="yoqotish_holati == 'ortiqcha'"
                                           decoration-success="yoqotish_holati == 'norma'"/>
                                    <field name="summa" sum="Jami summa"/>
                                    <field name="holat" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Izoh" name="izoh">
                            <field name="izoh"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_boquv_partiya_search" model="ir.ui.view">
        <field name="name">agronova.boquv.partiya.search</field>
        <field name="model">agronova.boquv.partiya</field>
        <field name="arch" type="xml">
            <search string="Partiyalar">
                <field name="name"/>
                <field name="filial_id"/>
                <field name="bino_id"/>
                <field name="brigadir_id"/>
                <filter name="filter_active" string="Faol"
                        domain="[('holat', '=', 'active')]"/>
                <filter name="filter_kutilmoqda" string="Jo'ja kutilmoqda"
                        domain="[('holat', '=', 'kutilmoqda')]"/>
                <filter name="filter_closed" string="Yopilgan"
                        domain="[('holat', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_ogish" string="Normadan og'ish bor"
                        domain="[('ogish_bormi', '=', True)]"/>
                <filter name="filter_ortiqcha_kutish" string="Ortiqcha kutish"
                        domain="[('ortiqcha_kutish_kun', '>', 0)]"/>
                <separator/>
                <filter name="filter_bu_yil" string="Shu yil"
                        domain="[('ochilish_sana', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <group>
                    <filter name="group_filial" string="Filial"
                            context="{'group_by': 'filial_id'}"/>
                    <filter name="group_bino" string="Bino"
                            context="{'group_by': 'bino_id'}"/>
                    <filter name="group_holat" string="Holati"
                            context="{'group_by': 'holat'}"/>
                    <filter name="group_oy" string="Ochilgan oy"
                            context="{'group_by': 'ochilish_sana:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_boquv_partiya_pivot" model="ir.ui.view">
        <field name="name">agronova.boquv.partiya.pivot</field>
        <field name="model">agronova.boquv.partiya</field>
        <field name="arch" type="xml">
            <pivot string="Partiyalar tahlili">
                <field name="filial_id" type="row"/>
                <field name="bino_id" type="row"/>
                <field name="ochilish_sana" interval="month" type="col"/>
                <field name="boshlangich_son" type="measure"/>
                <field name="joriy_son" type="measure"/>
                <field name="nobud_son" type="measure"/>
                <field name="nobud_foiz" type="measure"/>
                <field name="fcr" type="measure"/>
                <field name="epef" type="measure"/>
                <field name="jami_xarajat" type="measure"/>
                <field name="tannarx_1_bosh" type="measure"/>
                <field name="tannarx_1_kg" type="measure"/>
                <field name="jami_daromad" type="measure"/>
                <field name="foyda" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_boquv_partiya_graph" model="ir.ui.view">
        <field name="name">agronova.boquv.partiya.graph</field>
        <field name="model">agronova.boquv.partiya</field>
        <field name="arch" type="xml">
            <graph string="Partiyalar samaradorligi" type="bar">
                <field name="filial_id"/>
                <field name="foyda" type="measure"/>
                <field name="tannarx_1_bosh" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_boquv_partiya" model="ir.actions.act_window">
        <field name="name">Partiyalar</field>
        <field name="res_model">agronova.boquv.partiya</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Birinchi partiyani oching</p>
            <p>
                Partiya — bir binoda bir vaqtda boqiladigan jo'jalar guruhi
                (o'rtacha 45 kun). Barcha xarajat shu partiyaga yig'iladi,
                <b>1 bosh va 1 kg tirik vazn tannarxi har kuni yangilanadi</b>.
            </p>
        </field>
    </record>

    <record id="action_boquv_partiya_tahlil" model="ir.actions.act_window">
        <field name="name">Partiyalar tahlili</field>
        <field name="res_model">agronova.boquv.partiya</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Filiallar va partiyalar kesimida samaradorlik, tannarx va rentabellik tahlili.</p>
        </field>
    </record>

    <!-- ============================================ KUNLIK TANNARX -->

    <record id="view_boquv_tannarx_list" model="ir.ui.view">
        <field name="name">agronova.boquv.tannarx.kunlik.list</field>
        <field name="model">agronova.boquv.tannarx.kunlik</field>
        <field name="arch" type="xml">
            <list string="Kunlik tannarx" create="0">
                <field name="sana"/>
                <field name="partiya_id"/>
                <field name="bino_id" optional="show"/>
                <field name="yosh_kun"/>
                <field name="tirik_son"/>
                <field name="nobud_foiz" widget="percentage" optional="show"/>
                <field name="ortacha_vazn" optional="show"/>
                <field name="yem_sarf_kg" optional="hide"/>
                <field name="fcr"/>
                <field name="epef" optional="hide"/>
                <field name="jami_xarajat"/>
                <field name="tannarx_1_bosh"/>
                <field name="oldingi_1_bosh" optional="show"/>
                <field name="ozgarish_1_bosh" optional="show"/>
                <field name="tannarx_1_kg"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_boquv_tannarx_graph" model="ir.ui.view">
        <field name="name">agronova.boquv.tannarx.kunlik.graph</field>
        <field name="model">agronova.boquv.tannarx.kunlik</field>
        <field name="arch" type="xml">
            <graph string="Tannarx dinamikasi" type="line">
                <field name="sana" interval="day"/>
                <field name="tannarx_1_bosh" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_boquv_tannarx_pivot" model="ir.ui.view">
        <field name="name">agronova.boquv.tannarx.kunlik.pivot</field>
        <field name="model">agronova.boquv.tannarx.kunlik</field>
        <field name="arch" type="xml">
            <pivot string="Tannarx tahlili">
                <field name="filial_id" type="row"/>
                <field name="sana" interval="month" type="col"/>
                <field name="tannarx_1_bosh" type="measure"/>
                <field name="tannarx_1_kg" type="measure"/>
                <field name="fcr" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_boquv_tannarx" model="ir.actions.act_window">
        <field name="name">Kunlik tannarx</field>
        <field name="res_model">agronova.boquv.tannarx.kunlik</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Snapshot hali yozilmagan</p>
            <p>
                Har kecha cron faol partiyalar bo'yicha tannarx holatini
                yozib boradi. Shundan <b>bugungi va kechagi tannarx</b>
                solishtiriladi va dinamika grafigi chiziladi.
            </p>
        </field>
    </record>

</odoo>
