<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- O'z kategoriyamiz: tashqi `base.module_category_*` xmlid lariga
             bog'lanmaymiz, ular hamma bazada mavjud emas. -->
        <record id="module_category_qx" model="ir.module.category">
            <field name="name">AgroNova — Qishloq xo'jaligi</field>
            <field name="sequence">46</field>
        </record>

        <record id="res_groups_privilege_qx" model="res.groups.privilege">
            <field name="name">AgroNova — Qishloq xo'jaligi</field>
            <field name="category_id" ref="module_category_qx"/>
            <field name="sequence">46</field>
        </record>

        <record id="group_qx_agronom" model="res.groups">
            <field name="name">Agronom</field>
            <field name="privilege_id" ref="res_groups_privilege_qx"/>
            <field name="sequence">10</field>
            <field name="comment">Dalada bajarilgan ishlarni va hosilni kiritadi.</field>
        </record>

        <record id="group_qx_boshliq" model="res.groups">
            <field name="name">Bo'lim boshlig'i</field>
            <field name="privilege_id" ref="res_groups_privilege_qx"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_qx_agronom'))]"/>
            <field name="comment">Yer va partiya ochish, yopish, hisobotlar.</field>
        </record>

        <record id="group_qx_hisobchi" model="res.groups">
            <field name="name">Hisobchi</field>
            <field name="privilege_id" ref="res_groups_privilege_qx"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_qx_boshliq'))]"/>
            <field name="comment">Tannarx, ichki narx, moliyaviy hisobotlar.</field>
        </record>

    </data>
</odoo>
