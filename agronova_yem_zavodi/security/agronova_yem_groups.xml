<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- TZ 15: rollar. Har biri pastdagini o'z ichiga oladi; tarozi va
             MRP huquqlari ham shu yerdan meros. -->
        <record id="module_category_yem" model="ir.module.category">
            <field name="name">AgroNova — Yem zavodi</field>
            <field name="sequence">45</field>
        </record>

        <record id="res_groups_privilege_yem" model="res.groups.privilege">
            <field name="name">AgroNova — Yem zavodi</field>
            <field name="category_id" ref="module_category_yem"/>
            <field name="sequence">45</field>
        </record>

        <record id="group_yem_ishchi" model="res.groups">
            <field name="name">Yem — ishlab chiqarish xodimi</field>
            <field name="privilege_id" ref="res_groups_privilege_yem"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
            <field name="comment">To'xtash va yo'qotishni qayd etadi, smena hisobotini ko'radi.</field>
        </record>

        <record id="group_yem_smena_boshligi" model="res.groups">
            <field name="name">Yem — smena boshlig'i</field>
            <field name="privilege_id" ref="res_groups_privilege_yem"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_yem_ishchi'))]"/>
            <field name="comment">Smena hisoboti, qadoqlash va energiya yozuvlarini kiritadi va tasdiqlaydi.</field>
        </record>

        <record id="group_yem_omborchi" model="res.groups">
            <field name="name">Yem — omborchi</field>
            <field name="privilege_id" ref="res_groups_privilege_yem"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_yem_ishchi')), (4, ref('stock.group_stock_user')),
                                             (4, ref('agronova_tarozi.group_tarozi_operator'))]"/>
            <field name="comment">Xomashyo kirimi, tarozi, jo'natma va zaxira nazorati.</field>
        </record>

        <record id="group_yem_texnolog" model="res.groups">
            <field name="name">Yem — texnolog</field>
            <field name="privilege_id" ref="res_groups_privilege_yem"/>
            <field name="sequence">40</field>
            <field name="implied_ids" eval="[(4, ref('group_yem_ishchi'))]"/>
            <field name="comment">Retsepturani va me'yorlarni o'zgartiradi, yangi versiyani tasdiqlaydi.</field>
        </record>

        <record id="group_yem_boshliq" model="res.groups">
            <field name="name">Yem — ishlab chiqarish boshlig'i</field>
            <field name="privilege_id" ref="res_groups_privilege_yem"/>
            <field name="sequence">50</field>
            <field name="implied_ids" eval="[(4, ref('group_yem_smena_boshligi')), (4, ref('group_yem_omborchi')),
                                             (4, ref('mrp.group_mrp_manager')),
                                             (4, ref('agronova_tarozi.group_tarozi_masul'))]"/>
            <field name="comment">Reja, me'yordan tashqari sarf, yo'qotish va tafovutni tasdiqlaydi; smenani tuzatishga ochadi.</field>
        </record>

        <record id="group_yem_direktor" model="res.groups">
            <field name="name">Yem — zavod direktori</field>
            <field name="privilege_id" ref="res_groups_privilege_yem"/>
            <field name="sequence">60</field>
            <field name="implied_ids" eval="[(4, ref('group_yem_boshliq')), (4, ref('group_yem_texnolog'))]"/>
            <field name="comment">Yem zavodidagi barcha amallar va sozlamalar.</field>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_yem_direktor'))]"/>
        </record>

    </data>
</odoo>
