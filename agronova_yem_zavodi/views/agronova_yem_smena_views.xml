<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agronova_yem_smena_list" model="ir.ui.view">
        <field name="name">agronova.yem.smena.list</field>
        <field name="model">agronova.yem.smena</field>
        <field name="arch" type="xml">
            <list decoration-danger="bajarilish &lt; 90 and bajarilish &gt; 0">
                <field name="sana"/>
                <field name="smena_turi_id"/>
                <field name="liniya_id"/>
                <field name="boshliq_id" optional="show"/>
                <field name="reja_kg" optional="hide" sum="Jami"/>
                <field name="rejadagi_kg" sum="Jami"/>
                <field name="fakt_kg" sum="Jami"/>
                <field name="bajarilish" widget="progressbar"/>
                <field name="qadoqlangan_kg" sum="Jami" optional="show"/>
                <field name="qop_soni" sum="Jami" optional="hide"/>
                <field name="yoqotish_kg" sum="Jami" optional="show"/>
                <field name="toxtash_min" sum="Jami" optional="show"/>
                <field name="samaradorlik" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'tasdiqlangan'"/>
            </list>
        </field>
    </record>

    <record id="view_agronova_yem_smena_form" model="ir.ui.view">
        <field name="name">agronova.yem.smena.form</field>
        <field name="model">agronova.yem.smena</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_buyurtmalarni_bogla" type="object" string="Buyurtmalarni biriktirish"
                            invisible="state != 'draft'"/>
                    <button name="action_tasdiqlash" type="object" string="Smenani tasdiqlash" class="btn-primary"
                            groups="agronova_yem_zavodi.group_yem_smena_boshligi" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="sana" readonly="state != 'draft'"/>
                            <field name="smena_turi_id" readonly="state != 'draft'"/>
                            <field name="liniya_id" readonly="state != 'draft'"/>
                            <field name="boshliq_id" readonly="state != 'draft'"/>
                            <field name="ishchi_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="reja_kg" readonly="state != 'draft'"/>
                        </group>
                        <group string="Natija">
                            <field name="rejadagi_kg"/>
                            <field name="fakt_kg" class="fw-bold"/>
                            <field name="farq_kg" decoration-danger="farq_kg &lt; 0" decoration-success="farq_kg &gt;= 0"/>
                            <field name="bajarilish" widget="progressbar"/>
                            <field name="samaradorlik" widget="progressbar"/>
                            <field name="xomashyo_kg"/>
                            <field name="qadoqlangan_kg"/>
                            <field name="qop_soni"/>
                            <field name="yoqotish_kg"/>
                            <field name="brak_kg"/>
                            <field name="toxtash_min"/>
                            <field name="ochiq_buyurtma" invisible="not ochiq_buyurtma" decoration-warning="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Buyurtmalar" name="buyurtmalar">
                            <field name="production_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="agronova_bom_versiya"/>
                                    <field name="product_qty"/>
                                    <field name="agronova_kirim_kg" sum="Jami"/>
                                    <field name="agronova_miqdor_kg" sum="Jami"/>
                                    <field name="agronova_haqiqiy_yoqotish_kg" sum="Jami"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Qadoqlash" name="qadoqlash">
                            <field name="qadoqlash_ids" readonly="state != 'draft'" context="{'default_smena_id': id, 'default_liniya_id': liniya_id}">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="qop_soni" sum="Jami"/>
                                    <field name="brutto_kg" sum="Jami"/>
                                    <field name="netto_kg" sum="Jami"/>
                                    <field name="toldirish_farq_kg"/>
                                    <field name="toldirish_holat" widget="badge" decoration-success="toldirish_holat == 'normal'"
                                           decoration-warning="toldirish_holat != 'normal'"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Yo'qotish va brak" name="yoqotish">
                            <field name="yoqotish_ids" readonly="state != 'draft'" context="{'default_smena_id': id, 'default_liniya_id': liniya_id}">
                                <list>
                                    <field name="name"/>
                                    <field name="turi"/>
                                    <field name="product_id"/>
                                    <field name="miqdor_kg" sum="Jami"/>
                                    <field name="meyoriy_kg" sum="Jami"/>
                                    <field name="ortiqcha_kg" sum="Jami"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="To'xtashlar" name="toxtash">
                            <field name="toxtash_ids" readonly="state != 'draft'" context="{'default_smena_id': id, 'default_liniya_id': liniya_id}">
                                <list editable="bottom">
                                    <field name="liniya_id" column_invisible="1"/>
                                    <field name="boshlanish"/>
                                    <field name="tugash"/>
                                    <field name="davomiylik_min" sum="Jami"/>
                                    <field name="sabab"/>
                                    <field name="uskuna"/>
                                    <field name="izoh"/>
                                </list>
                            </field>
                        </page>
                        <page string="Energiya" name="energiya">
                            <field name="energiya_ids" readonly="state != 'draft'"
                                   context="{'default_smena_id': id, 'default_liniya_id': liniya_id, 'default_sana': sana}">
                                <list editable="bottom">
                                    <field name="sana" column_invisible="1"/>
                                    <field name="liniya_id" column_invisible="1"/>
                                    <field name="elektr_kwh" sum="Jami"/>
                                    <field name="gaz_m3" sum="Jami"/>
                                    <field name="kwh_t"/>
                                    <field name="summa" sum="Jami"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Izoh va tuzatish" name="izoh">
                            <field name="izoh" readonly="state != 'draft'" placeholder="Smena izohi..."/>
                            <group invisible="state != 'tasdiqlangan'" groups="agronova_yem_zavodi.group_yem_boshliq">
                                <field name="tuzatish_sabab" placeholder="Nima uchun tuzatish kerak?"/>
                                <button name="action_tuzatishga_ochish" type="object" string="Tuzatish uchun ochish"
                                        class="btn-secondary" colspan="2"/>
                            </group>
                            <group>
                                <field name="tasdiqlagan_id" invisible="not tasdiqlagan_id"/>
                                <field name="tasdiq_vaqt" invisible="not tasdiq_vaqt"/>
                                <field name="tuzatish_soni" invisible="not tuzatish_soni"/>
                                <field name="bot_kiritdi" invisible="not bot_kiritdi"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_agronova_yem_smena_search" model="ir.ui.view">
        <field name="name">agronova.yem.smena.search</field>
        <field name="model">agronova.yem.smena</field>
        <field name="arch" type="xml">
            <search>
                <field name="liniya_id"/>
                <field name="boshliq_id"/>
                <filter name="ochiq" string="Ochiq" domain="[('state', '=', 'draft')]"/>
                <filter name="reja_bajarilmagan" string="Reja bajarilmagan"
                        domain="[('bajarilish', '&lt;', 95), ('bajarilish', '&gt;', 0)]"/>
                <filter name="toxtashli" string="To'xtash bo'lgan" domain="[('toxtash_min', '&gt;', 0)]"/>
                <filter name="bugun" string="Bugun" domain="[('sana', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="sana" string="Sana" date="sana"/>
                <group>
                    <filter name="g_liniya" string="Liniya" context="{'group_by': 'liniya_id'}"/>
                    <filter name="g_smena" string="Smena" context="{'group_by': 'smena_turi_id'}"/>
                    <filter name="g_boshliq" string="Smena boshlig'i" context="{'group_by': 'boshliq_id'}"/>
                    <filter name="g_kun" string="Kun" context="{'group_by': 'sana:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_agronova_yem_smena_pivot" model="ir.ui.view">
        <field name="name">agronova.yem.smena.pivot</field>
        <field name="model">agronova.yem.smena</field>
        <field name="arch" type="xml">
            <pivot string="Smena samaradorligi" sample="1">
                <field name="liniya_id" type="row"/>
                <field name="smena_turi_id" type="col"/>
                <field name="rejadagi_kg" type="measure"/>
                <field name="fakt_kg" type="measure"/>
                <field name="toxtash_min" type="measure"/>
                <field name="yoqotish_kg" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_agronova_yem_smena_graph" model="ir.ui.view">
        <field name="name">agronova.yem.smena.graph</field>
        <field name="model">agronova.yem.smena</field>
        <field name="arch" type="xml">
            <graph string="Smena" type="bar" sample="1">
                <field name="sana" interval="day"/>
                <field name="smena_turi_id"/>
                <field name="fakt_kg" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_agronova_yem_smena" model="ir.actions.act_window">
        <field name="name">Smena hisobotlari</field>
        <field name="res_model">agronova.yem.smena</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_agronova_yem_smena_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Smena hisobotini oching</p>
            <p>Fakt, xomashyo, qadoq, yo'qotish va to'xtashlar smenaga bog'langan hujjatlardan avtomatik yig'iladi. Tasdiqlangan hisobot o'zgarmaydi.</p>
        </field>
    </record>

    <record id="action_agronova_yem_smena_samaradorlik" model="ir.actions.act_window">
        <field name="name">Smena samaradorligi</field>
        <field name="res_model">agronova.yem.smena</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_agronova_yem_smena_search"/>
    </record>

</odoo>
