<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agronova_yem_jonatma_list" model="ir.ui.view">
        <field name="name">agronova.yem.jonatma.list</field>
        <field name="model">agronova.yem.jonatma</field>
        <field name="arch" type="xml">
            <list decoration-danger="tafovut == 'kritik'" decoration-warning="tafovut in ('tasdiq', 'ogohlantirish')"
                  decoration-muted="state == 'bekor'">
                <field name="name"/>
                <field name="sana"/>
                <field name="turi"/>
                <field name="partner_id"/>
                <field name="qabul_location_id" optional="show"/>
                <field name="avto_raqam" optional="show"/>
                <field name="qop_soni" sum="Jami" optional="show"/>
                <field name="hujjat_kg" sum="Jami"/>
                <field name="haqiqiy_kg" sum="Jami"/>
                <field name="farq_kg" sum="Jami"/>
                <field name="tafovut" widget="badge" decoration-success="tafovut == 'normal'"
                       decoration-warning="tafovut in ('ogohlantirish', 'tasdiq')" decoration-danger="tafovut == 'kritik'"/>
                <field name="summa" sum="Jami" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'jonatildi'"
                       decoration-info="state in ('tasdiqlangan', 'tortildi')"/>
            </list>
        </field>
    </record>

    <record id="view_agronova_yem_jonatma_form" model="ir.ui.view">
        <field name="name">agronova.yem.jonatma.form</field>
        <field name="model">agronova.yem.jonatma</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_tasdiqlash" type="object" string="Tasdiqlash" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_tortish" type="object" string="Tarozida tortish" icon="fa-balance-scale"
                            class="btn-primary" invisible="state != 'tasdiqlangan'"/>
                    <button name="action_jonatish" type="object" string="Jo'natish" class="btn-success"
                            invisible="state not in ('tasdiqlangan', 'tortildi')"/>
                    <button name="action_bekor" type="object" string="Bekor qilish" invisible="state in ('jonatildi', 'bekor')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,tasdiqlangan,tortildi,jonatildi"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <div class="o_stat_info"><span class="o_stat_text">Ombor hujjati</span></div>
                        </button>
                        <button name="action_sale" type="object" class="oe_stat_button" icon="fa-dollar" invisible="not sale_id">
                            <div class="o_stat_info"><span class="o_stat_text">Sotuv</span></div>
                        </button>
                        <button name="action_tortish" type="object" class="oe_stat_button" icon="fa-balance-scale"
                                invisible="not tortish_id">
                            <div class="o_stat_info">
                                <field name="haqiqiy_kg" class="o_stat_value" widget="float" digits="[16, 0]"/>
                                <span class="o_stat_text">kg tarozida</span>
                            </div>
                        </button>
                    </div>
                    <div class="alert alert-info mb-2" role="alert" invisible="not ichki">
                        Ichki jo'natma sotuv hisoblanmaydi: faktura yaratilmaydi, yem qabul qiluvchi omborga ko'chiriladi.
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="turi" readonly="state != 'draft'"/>
                            <field name="ichki" invisible="1"/>
                            <field name="sana" readonly="state not in ('draft', 'tasdiqlangan')"/>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"
                                   required="turi in ('sotuv', 'qaytarish')"/>
                            <field name="sale_id" readonly="state != 'draft'" invisible="turi != 'sotuv'"
                                   domain="[('partner_id', '=', partner_id), ('state', 'in', ('draft', 'sent', 'sale'))]"/>
                            <field name="qabul_location_id" invisible="not ichki" readonly="state != 'draft'"
                                   required="ichki"/>
                            <field name="qabul_qiluvchi"/>
                        </group>
                        <group string="Transport">
                            <field name="avto_raqam"/>
                            <field name="haydovchi"/>
                            <field name="masul_id"/>
                            <field name="picking_id" invisible="not picking_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mahsulotlar" name="qatorlar">
                            <field name="qator_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qop_soni" sum="Jami"/>
                                    <field name="qop_sigim_kg" optional="show"/>
                                    <field name="miqdor_kg" sum="Jami"/>
                                    <field name="narx_kg" column_invisible="parent.ichki"/>
                                    <field name="summa" sum="Jami" column_invisible="parent.ichki"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="hujjat_kg"/>
                                <field name="qop_soni"/>
                                <field name="nominal_kg"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="summa" invisible="ichki"/>
                            </group>
                        </page>
                        <page string="Og'irlik nazorati" name="tarozi" invisible="not tortish_id">
                            <group>
                                <group>
                                    <field name="tortish_id"/>
                                    <field name="hujjat_kg"/>
                                    <field name="qoplar_kg"/>
                                    <field name="nominal_kg"/>
                                    <field name="haqiqiy_kg"/>
                                </group>
                                <group>
                                    <field name="farq_kg"/>
                                    <field name="farq_pct"/>
                                    <field name="tafovut" widget="badge" decoration-success="tafovut == 'normal'"
                                           decoration-warning="tafovut in ('ogohlantirish', 'tasdiq')"
                                           decoration-danger="tafovut == 'kritik'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Izoh" name="izoh"><field name="izoh"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_agronova_yem_jonatma_search" model="ir.ui.view">
        <field name="name">agronova.yem.jonatma.search</field>
        <field name="model">agronova.yem.jonatma</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="avto_raqam"/>
                <filter name="sotuv" string="Tashqi sotuv" domain="[('turi', '=', 'sotuv')]"/>
                <filter name="ichki" string="Ichki iste'mol" domain="[('ichki', '=', True)]"/>
                <separator/>
                <filter name="tafovutli" string="Og'irlik tafovuti" domain="[('tafovut', 'in', ('ogohlantirish', 'tasdiq', 'kritik'))]"/>
                <filter name="ochiq" string="Jo'natilmagan" domain="[('state', 'in', ('draft', 'tasdiqlangan', 'tortildi'))]"/>
                <filter name="sana" string="Sana" date="sana"/>
                <group>
                    <filter name="g_turi" string="Turi" context="{'group_by': 'turi'}"/>
                    <filter name="g_partner" string="Mijoz" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_kun" string="Kun" context="{'group_by': 'sana:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_agronova_yem_jonatma_pivot" model="ir.ui.view">
        <field name="name">agronova.yem.jonatma.pivot</field>
        <field name="model">agronova.yem.jonatma</field>
        <field name="arch" type="xml">
            <pivot string="Jo'natmalar" sample="1">
                <field name="turi" type="row"/>
                <field name="sana" interval="month" type="col"/>
                <field name="hujjat_kg" type="measure"/>
                <field name="farq_kg" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_agronova_yem_jonatma" model="ir.actions.act_window">
        <field name="name">Jo'natmalar</field>
        <field name="res_model">agronova.yem.jonatma</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_agronova_yem_jonatma_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Yem jo'natmasini oching</p>
            <p>Tashqi mijozga sotuv yoki ona tovuq, boquv va boshqa ichki xo'jaliklarga chiqim. Har jo'natma tarozida tortiladi, hujjat bilan farq nazorat qilinadi.</p>
        </field>
    </record>

</odoo>
