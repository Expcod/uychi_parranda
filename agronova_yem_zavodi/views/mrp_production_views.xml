<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ishlab chiqarish hujjatida tannarx bo'limi -->
    <record id="view_mrp_production_form_tannarx" model="ir.ui.view">
        <field name="name">mrp.production.form.agronova.tannarx</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Tannarx" name="agronova_tannarx"
                      invisible="state != 'done'">
                    <group>
                        <group string="Haqiqiy tannarx">
                            <field name="currency_id" invisible="1"/>
                            <field name="agronova_xomashyo_qiymat"/>
                            <field name="agronova_ustama_qiymat"/>
                            <field name="agronova_jami_tannarx"/>
                            <field name="agronova_xomashyo_ulush"
                                   widget="percentage" digits="[12,1]"/>
                        </group>
                        <group string="Birlik tannarxi">
                            <field name="agronova_miqdor_kg"/>
                            <field name="agronova_tannarx_1_kg"/>
                            <field name="agronova_tannarx_1_tonna"/>
                        </group>
                    </group>
                    <group string="Reja va fakt">
                        <group>
                            <field name="agronova_reja_tannarx_1_kg"/>
                            <field name="agronova_tannarx_1_kg"
                                   string="Fakt: 1 kg tannarxi"/>
                            <field name="agronova_chetlanish"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Reja retsept bo'yicha hisoblanadi: komponentlarning
                        standart narxi + operatsiya vaqti × ish markazi tarifi.
                        Fakt esa haqiqatda sarflangan xomashyoning FIFO
                        qiymatidan chiqadi.
                    </div>
                </page>
            </notebook>
        </field>
    </record>

    <!-- ============================================ TANNARX HISOBOTI -->
    <record id="view_agronova_yem_tannarx_list" model="ir.ui.view">
        <field name="name">mrp.production.agronova.tannarx.list</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <list string="Ishlab chiqarish tannarxi" create="false"
                  decoration-danger="agronova_chetlanish &gt; 10"
                  decoration-success="agronova_chetlanish &lt; -5">
                <field name="date_start"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="agronova_miqdor_kg" sum="Jami kg"/>
                <field name="agronova_xomashyo_qiymat" sum="Xomashyo"/>
                <field name="agronova_ustama_qiymat" sum="Ishlab chiqarish"/>
                <field name="agronova_jami_tannarx" sum="Jami tannarx"/>
                <field name="agronova_xomashyo_ulush" optional="show"/>
                <field name="agronova_tannarx_1_kg"/>
                <field name="agronova_tannarx_1_tonna" optional="show"/>
                <field name="agronova_reja_tannarx_1_kg" optional="hide"/>
                <field name="agronova_chetlanish" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_agronova_yem_tannarx_pivot" model="ir.ui.view">
        <field name="name">mrp.production.agronova.tannarx.pivot</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <pivot string="Tannarx tahlili" sample="1">
                <field name="product_id" type="row"/>
                <field name="date_start" interval="month" type="col"/>
                <field name="agronova_miqdor_kg" type="measure"/>
                <field name="agronova_jami_tannarx" type="measure"/>
                <field name="agronova_tannarx_1_kg" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_agronova_yem_tannarx_graph" model="ir.ui.view">
        <field name="name">mrp.production.agronova.tannarx.graph</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <graph string="Tannarx dinamikasi" type="line" sample="1">
                <field name="date_start" interval="month"/>
                <field name="agronova_tannarx_1_kg" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_agronova_yem_tannarx_search" model="ir.ui.view">
        <field name="name">mrp.production.agronova.tannarx.search</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <search string="Ishlab chiqarish tannarxi">
                <field name="name"/>
                <field name="product_id"/>
                <filter name="rejadan_qimmat" string="Rejadan qimmat"
                        domain="[('agronova_chetlanish', '&gt;', 0)]"/>
                <filter name="rejadan_arzon" string="Rejadan arzon"
                        domain="[('agronova_chetlanish', '&lt;', 0)]"/>
                <separator/>
                <!-- Sana bo'yicha filtr Odooning standart oy tanlagichi
                     bilan qilinadi — `relativedelta` ko'rinish tekshiruvidan
                     o'tmaydi. -->
                <filter name="sana" string="Sana" date="date_start"/>
                <group>
                    <filter name="g_product" string="Mahsulot"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="g_oy" string="Oy"
                            context="{'group_by': 'date_start:month'}"/>
                    <filter name="g_hafta" string="Hafta"
                            context="{'group_by': 'date_start:week'}"/>
                    <filter name="g_kompaniya" string="Korxona"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agronova_yem_tannarx" model="ir.actions.act_window">
        <field name="name">Ishlab chiqarish tannarxi</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="search_view_id" ref="view_agronova_yem_tannarx_search"/>
        <field name="context">{'search_default_g_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hali yakunlangan ishlab chiqarish yo'q</p>
            <p>Ishlab chiqarish buyurtmasi yakunlangandan keyin bu yerda
               1 kg va 1 tonna tannarxi, xomashyo ulushi va rejadan
               chetlanish ko'rinadi.</p>
        </field>
    </record>

</odoo>
