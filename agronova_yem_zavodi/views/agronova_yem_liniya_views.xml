<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agronova_yem_liniya_list" model="ir.ui.view">
        <field name="name">agronova.yem.liniya.list</field>
        <field name="model">agronova.yem.liniya</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kod"/>
                <field name="quvvat_t_soat"/>
                <field name="workcenter_id"/>
                <field name="tarozi_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_agronova_yem_liniya_form" model="ir.ui.view">
        <field name="name">agronova.yem.liniya.form</field>
        <field name="model">agronova.yem.liniya</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_productions" type="object" class="oe_stat_button" icon="fa-industry">
                            <field name="production_count" widget="statinfo" string="Buyurtmalar"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Masalan: Granula liniyasi №1"/></h1></div>
                    <group>
                        <group>
                            <field name="kod"/>
                            <field name="quvvat_t_soat"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="workcenter_id"/>
                            <field name="tarozi_id"/>
                        </group>
                    </group>
                    <field name="izoh" placeholder="Uskunalar, texnologik sxema..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_agronova_yem_liniya" model="ir.actions.act_window">
        <field name="name">Ishlab chiqarish liniyalari</field>
        <field name="res_model">agronova.yem.liniya</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_agronova_yem_smena_turi_list" model="ir.ui.view">
        <field name="name">agronova.yem.smena.turi.list</field>
        <field name="model">agronova.yem.smena.turi</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="boshlanish" widget="float_time"/>
                <field name="tugash" widget="float_time"/>
                <field name="davomiylik"/>
            </list>
        </field>
    </record>

    <record id="action_agronova_yem_smena_turi" model="ir.actions.act_window">
        <field name="name">Smenalar</field>
        <field name="res_model">agronova.yem.smena.turi</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
