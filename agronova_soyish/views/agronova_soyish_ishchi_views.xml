<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= BOSQICHLAR -->
    <record id="view_soyish_bosqich_list" model="ir.ui.view">
        <field name="name">agronova.soyish.bosqich.list</field>
        <field name="model">agronova.soyish.bosqich</field>
        <field name="arch" type="xml">
            <list string="Ish bosqichlari" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="olchov"/>
                <field name="narx"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="izoh" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_soyish_bosqich" model="ir.actions.act_window">
        <field name="name">Ish bosqichlari</field>
        <field name="res_model">agronova.soyish.bosqich</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Bosqich qo'shing</p>
            <p>Qo'l mehnati bosqichlari, masalan bo'laklash. Tozalash va
               ichini tozalashni apparat qiladi — ularni qo'shish shart emas.
               Ishbay narx shu yerda — xodim ishlagan dona × narx.</p>
        </field>
    </record>

    <!-- ===================================================== XODIMLAR ISHI -->
    <record id="view_soyish_ishchi_list" model="ir.ui.view">
        <field name="name">agronova.soyish.ishchi.list</field>
        <field name="model">agronova.soyish.ishchi</field>
        <field name="arch" type="xml">
            <list string="Xodimlar ishi" create="false"
                  expand="context.get('expand', False)"
                  decoration-muted="holat == 'draft'"
                  decoration-danger="brak_foiz &gt; 3">
                <field name="sana"/>
                <field name="employee_id"/>
                <field name="bosqich_id"/>
                <field name="partiya_id" optional="show"/>
                <field name="dona" sum="Dona"/>
                <field name="kg" sum="kg" optional="show"/>
                <field name="brak_son" sum="Brak"/>
                <field name="brak_foiz" optional="show"/>
                <field name="soat" widget="float_time" sum="Soat" optional="show"/>
                <field name="dona_soat"/>
                <field name="summa" sum="Ishbay haqi"
                       groups="agronova_soyish.group_soyish_boshliq"/>
                <field name="holat" widget="badge" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_soyish_ishchi_pivot" model="ir.ui.view">
        <field name="name">agronova.soyish.ishchi.pivot</field>
        <field name="model">agronova.soyish.ishchi</field>
        <field name="arch" type="xml">
            <pivot string="Xodimlar unumdorligi" sample="1">
                <field name="employee_id" type="row"/>
                <field name="bosqich_id" type="col"/>
                <field name="dona" type="measure"/>
                <field name="brak_son" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_soyish_ishchi_graph" model="ir.ui.view">
        <field name="name">agronova.soyish.ishchi.graph</field>
        <field name="model">agronova.soyish.ishchi</field>
        <field name="arch" type="xml">
            <graph string="Xodimlar unumdorligi" type="bar" sample="1">
                <field name="employee_id"/>
                <field name="bosqich_id"/>
                <field name="dona" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_soyish_ishchi_search" model="ir.ui.view">
        <field name="name">agronova.soyish.ishchi.search</field>
        <field name="model">agronova.soyish.ishchi</field>
        <field name="arch" type="xml">
            <search string="Xodimlar ishi">
                <field name="employee_id"/>
                <field name="bosqich_id"/>
                <field name="partiya_id"/>
                <filter name="bugun" string="Bugun"
                        domain="[('sana', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="hafta" string="Oxirgi 7 kun"
                        domain="[('sana', '>=', (context_today() - relativedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <filter name="oy" string="Shu oy"
                        domain="[('sana', '>=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="tasdiqlangan" string="Tasdiqlangan hujjatlar"
                        domain="[('holat', '=', 'done')]"/>
                <separator/>
                <filter name="brakli" string="Brak qilganlar"
                        domain="[('brak_son', '>', 0)]"/>
                <group>
                    <filter name="g_xodim" string="Xodim"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="g_bosqich" string="Bosqich"
                            context="{'group_by': 'bosqich_id'}"/>
                    <filter name="g_kun" string="Kun"
                            context="{'group_by': 'sana:day'}"/>
                    <filter name="g_oy" string="Oy"
                            context="{'group_by': 'sana:month'}"/>
                    <filter name="g_partiya" string="Partiya"
                            context="{'group_by': 'partiya_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_soyish_ishchi_hisobot" model="ir.actions.act_window">
        <field name="name">Xodimlar unumdorligi</field>
        <field name="res_model">agronova.soyish.ishchi</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="search_view_id" ref="view_soyish_ishchi_search"/>
        <field name="context">{'search_default_tasdiqlangan': 1, 'search_default_oy': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Ma'lumot yo'q</p>
            <p>So'yish hujjatidagi «Xodimlar ishi» varag'idan yig'iladi:
               har xodim qaysi bosqichda nechta tovuq ishlagani, brak,
               soatiga necha dona va ishbay haqi.</p>
        </field>
    </record>

    <!-- ============================================ BO'LAKLAR CHIQISHI -->
    <record id="view_soyish_natija_pivot" model="ir.ui.view">
        <field name="name">agronova.soyish.natija.pivot</field>
        <field name="model">agronova.soyish.natija</field>
        <field name="arch" type="xml">
            <pivot string="Bo'laklar chiqishi" sample="1">
                <field name="product_id" type="row"/>
                <field name="sana" interval="month" type="col"/>
                <field name="miqdor_kg" type="measure"/>
                <field name="tushka_ulush_foiz" type="measure"/>
                <field name="dona_ga_kg" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_soyish_natija_graph" model="ir.ui.view">
        <field name="name">agronova.soyish.natija.graph</field>
        <field name="model">agronova.soyish.natija</field>
        <field name="arch" type="xml">
            <graph string="Bo'laklar chiqishi" type="pie" sample="1">
                <field name="product_id"/>
                <field name="miqdor_kg" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_soyish_natija_search" model="ir.ui.view">
        <field name="name">agronova.soyish.natija.search</field>
        <field name="model">agronova.soyish.natija</field>
        <field name="arch" type="xml">
            <search string="Chiqqan mahsulotlar">
                <field name="product_id"/>
                <field name="partiya_id"/>
                <filter name="bugun" string="Bugun"
                        domain="[('sana', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="hafta" string="Oxirgi 7 kun"
                        domain="[('sana', '>=', (context_today() - relativedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <filter name="oy" string="Shu oy"
                        domain="[('sana', '>=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="tasdiqlangan" string="Tasdiqlangan"
                        domain="[('holat', '=', 'done')]"/>
                <separator/>
                <filter name="ichki" string="Ichki boquvdan"
                        domain="[('manba', '=', 'ichki')]"/>
                <filter name="tashqi" string="Tashqi mijozdan"
                        domain="[('manba', '=', 'tashqi')]"/>
                <group>
                    <filter name="g_product" string="Mahsulot"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="g_kun" string="Kun"
                            context="{'group_by': 'sana:day'}"/>
                    <filter name="g_partiya" string="Partiya"
                            context="{'group_by': 'partiya_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_soyish_hisobot_bolak" model="ir.actions.act_window">
        <field name="name">Bo'laklar chiqishi</field>
        <field name="res_model">agronova.soyish.natija</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_soyish_natija_search"/>
        <field name="context">{'search_default_tasdiqlangan': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Ma'lumot yo'q</p>
            <p>File, qanot, oyoq, bel va boshqa qismlar qancha chiqdi,
               jami mahsulotdagi ulushi va 1 tovuqdan o'rtacha necha kg.</p>
        </field>
    </record>

    <!-- ================================================ XODIM KARTOCHKASI -->
    <record id="view_employee_form_soyish" model="ir.ui.view">
        <field name="name">hr.employee.form.agronova.soyish</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_agronova_soyish_ishi" type="object"
                        class="oe_stat_button" icon="fa-cutlery"
                        groups="agronova_soyish.group_soyish_operator">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="agronova_soyish_jami_dona"/>
                        </span>
                        <span class="o_stat_text">So'yishda (dona)</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
