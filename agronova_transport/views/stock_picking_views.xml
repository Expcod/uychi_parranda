<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_form_trip" model="ir.ui.view">
        <field name="name">stock.picking.form.trip</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="scheduled_date" position="after">
                <field name="trip_id"/>
            </field>
        </field>
    </record>

    <record id="view_stock_picking_list_trip" model="ir.ui.view">
        <field name="name">stock.picking.list.trip</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="trip_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
