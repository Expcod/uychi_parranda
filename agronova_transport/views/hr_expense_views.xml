<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_expense_form_trip" model="ir.ui.view">
        <field name="name">hr.expense.form.trip</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="trip_id"/>
            </field>
        </field>
    </record>

    <record id="view_fleet_log_services_form_trip" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.trip</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form"/>
        <field name="arch" type="xml">
            <field name="vehicle_id" position="after">
                <field name="trip_id"/>
            </field>
        </field>
    </record>

</odoo>
