<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Reysda korxona qoidasi yo'q edi: boshqa korxonada turgan
             foydalanuvchiga reys ko'rinar, lekin uning xarajatlari
             (hr.expense — o'z korxona qoidasi bor) filtrlanib ketardi.
             Natijada forma chalg'itardi: tepada «Xarajat 90 000», pastda
             bo'sh ro'yxat. Endi reys ham o'z korxonasida ko'rinadi. -->
        <record id="agronova_trip_company_rule" model="ir.rule">
            <field name="name">Reys: korxona bo'yicha ko'rinish</field>
            <field name="model_id" ref="model_agronova_trip"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False),
                      ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>
