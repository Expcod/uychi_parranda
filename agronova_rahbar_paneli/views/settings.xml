<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="settings_feed_manager" model="ir.ui.view">
    <field name="name">res.config.settings.feed.manager</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="agronova_dashboard.res_config_settings_view_form_agronova"/>
    <field name="arch" type="xml">
      <xpath expr="//app[@name='agronova_dashboard']" position="inside">
        <block title="Yem zavodi rahbar paneli">
          <setting string="Yem zavodi korxonasi" help="Yem zavodi korxonasi. Bo'sh qoldirilsa, asosiy korxona olinadi. Barcha bo'limlar shu korxona bo'yicha hisoblanadi.">
            <field name="feed_manager_company_id"/>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>
