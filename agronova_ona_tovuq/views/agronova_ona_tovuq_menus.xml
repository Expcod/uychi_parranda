    <menuitem id="menu_ot_kunlik" name="Kunlik ish" parent="menu_ot_root" sequence="10"/>
    <menuitem id="menu_ot_jurnal_tuxum" name="Kunlik jurnal (ona tovuq)"
              parent="menu_ot_kunlik" action="action_ot_jurnal_tuxum" sequence="10"/>
    <menuitem id="menu_ot_jurnal_ostirish" name="Kunlik jurnal (jo'ja o'stirish)"
