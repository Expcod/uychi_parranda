<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="res_groups_privilege_agronova_kassa" model="res.groups.privilege">
            <field name="name">AgroNova — Kassa</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="sequence">45</field>
        </record>

        <record id="group_agronova_kassir" model="res.groups">
            <field name="name">Kassir</field>
            <field name="privilege_id" ref="res_groups_privilege_agronova_kassa"/>
            <field name="sequence">10</field>
            <field name="comment">Faqat o'ziga biriktirilgan kassada ishlaydi:
                kirim/chiqim orderi yozadi, kunni yopadi, transfer jo'natadi
                va qabul qiladi. Boshqa kassalarni ko'rmaydi.</field>
        </record>

        <record id="group_agronova_kassa_menejer" model="res.groups">
            <field name="name">Kassa menejeri</field>
            <field name="privilege_id" ref="res_groups_privilege_agronova_kassa"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_agronova_kassir'))]"/>
            <field name="comment">Barcha kassalarni ko'radi, yopilgan kunni
                qayta ochadi, orqaga sana bilan yozadi, kassa va modda
                kartochkalarini boshqaradi.</field>
        </record>

        <!-- Bosh buxgalter kassani to'liq ko'rsin (storno, qayta ochish). -->
        <record id="agronova_base.group_agronova_bosh_buxgalter" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_agronova_kassa_menejer'))]"/>
        </record>

    </data>
</odoo>
