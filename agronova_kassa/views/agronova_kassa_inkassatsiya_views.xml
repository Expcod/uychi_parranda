<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agronova_kassa_inkassatsiya_list" model="ir.ui.view">
        <field name="name">agronova.kassa.inkassatsiya.list</field>
        <field name="model">agronova.kassa.inkassatsiya</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'transit'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'rad'">
                <field name="name"/>
                <field name="date"/>
                <field name="kassa_id"/>
                <field name="bank_journal_id"/>
                <field name="inkassator" optional="show"/>
                <field name="hujjat_raqami" optional="show"/>
                <field name="amount" widget="monetary" sum="Jami"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="bank_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'transit'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'rad'"/>
            </list>
        </field>
    </record>

    <record id="view_agronova_kassa_inkassatsiya_form" model="ir.ui.view">
        <field name="name">agronova.kassa.inkassatsiya.form</field>
        <field name="model">agronova.kassa.inkassatsiya</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_topshirish" type="object"
                            string="Topshirish" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_bank_tasdiq" type="object"
                            string="Bank tasdiqladi" class="btn-primary"
                            invisible="state != 'transit'"/>
                    <button name="action_rad_wizard" type="object"
                            string="Rad etish" class="btn-secondary"
                            invisible="state != 'transit'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,transit,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_moves"
                                class="oe_stat_button" icon="fa-book"
                                string="Provodkalar" invisible="state == 'draft'"/>
                    </div>
                    <widget name="web_ribbon" title="RAD ETILGAN"
                            bg_color="text-bg-danger" invisible="state != 'rad'"/>
                    <div class="oe_title">
                        <span class="o_form_label">Inkassatsiya</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'transit'">
                        Pul kassadan chiqdi, lekin bank hisobiga hali
                        tushmadi. Bank ko'chirmasi kelgach «Bank tasdiqladi»
                        tugmasini bosing — shundagina 5110 hisobiga kirim
                        yoziladi.
                    </div>
                    <group>
                        <group string="Kimdan — kimga">
                            <field name="kassa_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="bank_journal_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="amount" widget="monetary"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Hujjat">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="bank_date"
                                   readonly="state not in ('draft', 'transit')"/>
                            <field name="inkassator"
                                   readonly="state not in ('draft', 'transit')"/>
                            <field name="hujjat_raqami"
                                   readonly="state not in ('draft', 'transit')"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Izoh">
                        <field name="izoh" nolabel="1"/>
                        <field name="rad_sabab" readonly="1"
                               invisible="state != 'rad'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_agronova_kassa_inkassatsiya_search" model="ir.ui.view">
        <field name="name">agronova.kassa.inkassatsiya.search</field>
        <field name="model">agronova.kassa.inkassatsiya</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="kassa_id"/>
                <field name="bank_journal_id"/>
                <field name="hujjat_raqami"/>
                <filter name="yolda" string="Yo'lda (bank kutilmoqda)"
                        domain="[('state', '=', 'transit')]"/>
                <filter name="tushdi" string="Bankka tushgan"
                        domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="g_kassa" string="Kassa"
                            context="{'group_by': 'kassa_id'}"/>
                    <filter name="g_bank" string="Bank hisobi"
                            context="{'group_by': 'bank_journal_id'}"/>
                    <filter name="g_state" string="Holat"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agronova_kassa_inkassatsiya" model="ir.actions.act_window">
        <field name="name">Inkassatsiya</field>
        <field name="res_model">agronova.kassa.inkassatsiya</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Inkassatsiya yarating</p>
            <p>Kassadagi ortiqcha naqdni bank hisobiga topshirish. Bank
               ko'chirmasi kelgunga qadar pul «Yo'ldagi pul» hisobida
               turadi.</p>
        </field>
    </record>

    <record id="view_agronova_kassa_inkassatsiya_rad_wizard_form" model="ir.ui.view">
        <field name="name">agronova.kassa.inkassatsiya.rad.wizard.form</field>
        <field name="model">agronova.kassa.inkassatsiya.rad.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert">
                    Rad etilganda pul kassaga qaytariladi va buxgalteriyada
                    qaytish provodkasi yoziladi.
                </div>
                <group>
                    <field name="inkassatsiya_id" readonly="1"/>
                    <field name="sabab"
                           placeholder="Bank qabul qilmadi / summa mos kelmadi..."/>
                </group>
                <footer>
                    <button name="action_tasdiqlash" type="object"
                            string="Rad etish" class="btn-danger"/>
                    <button string="Bekor" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
