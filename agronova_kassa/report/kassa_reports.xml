<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_kassa_chek" model="ir.actions.report">
        <field name="name">Kassa cheki (80mm)</field>
        <field name="model">agronova.kassa.harakat</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agronova_kassa.report_kassa_chek</field>
        <field name="report_file">agronova_kassa.report_kassa_chek</field>
        <field name="paperformat_id" ref="agronova_kassa.paperformat_kassa_chek"/>
        <field name="print_report_name">'Chek %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_agronova_kassa_harakat"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_kassa_kitobi" model="ir.actions.report">
        <field name="name">Kassa kitobi</field>
        <field name="model">agronova.kassa.kun</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agronova_kassa.report_kassa_kitobi</field>
        <field name="report_file">agronova_kassa.report_kassa_kitobi</field>
        <field name="print_report_name">'Kassa kitobi %s %s' % (object.kassa_id.name or '', object.date or '')</field>
        <field name="binding_model_id" ref="model_agronova_kassa_kun"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
