<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 80mm termoprinter uchun. Balandlik uzun cheklar ham sig'ishi
             uchun kattaroq olingan; qog'oz rulon bo'lgani uchun ortiqchasi
             kesilmaydi. -->
        <record id="paperformat_kassa_chek" model="report.paperformat">
            <field name="name">Kassa cheki 80mm</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_width">80</field>
            <field name="page_height">240</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">3</field>
            <field name="margin_bottom">3</field>
            <field name="margin_left">3</field>
            <field name="margin_right">3</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
        </record>

    </data>
</odoo>
