<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="agronova_kassa.Panel">
    <div class="o_agronova_kassa h-100 overflow-auto py-3 px-3">
        <div class="sk-container mx-auto">

            <!-- ================== SARLAVHA ================== -->
            <div class="sk-header rounded-3 p-3 mb-3 d-flex align-items-center flex-wrap gap-2">
                <span class="fs-1 me-2">&#128176;</span>
                <div class="flex-grow-1 sk-min0">
                    <h4 class="mb-0 fw-bold text-white">Kassa — naqd pul</h4>
                    <small class="text-white opacity-75">Kirim, chiqim, transfer va kassa kitobi</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input type="date" class="form-control form-control-sm sk-date"
                           t-att-value="state.date" t-on-change="onDateChange"/>
                    <button class="btn btn-sm btn-light" t-on-click="goToday"
                            t-if="!isToday">Bugun</button>
                </div>
            </div>

            <div t-if="state.loading" class="text-center py-5 text-muted">
                Yuklanmoqda...
            </div>

            <t t-else="">
                <!-- ================== KUTILAYOTGAN TRANSFERLAR ================== -->
                <div t-if="state.kutilayotgan.length" class="card rounded-3 shadow-sm mb-3 border-warning">
                    <div class="card-header fw-bold bg-warning-subtle">
                        &#8644; Sizni kutayotgan pul
                        <span class="badge text-bg-warning ms-2" t-esc="state.kutilayotgan.length"/>
                    </div>
                    <div class="list-group list-group-flush">
                        <div t-foreach="state.kutilayotgan" t-as="row" t-key="row.id"
                             class="list-group-item d-flex align-items-center flex-wrap gap-2">
                            <div class="flex-grow-1 sk-min0">
                                <div class="fw-bold">
                                    <t t-esc="row.from"/> &#8594; <t t-esc="row.to"/>
                                </div>
                                <small class="text-muted">
                                    <t t-esc="row.name"/>
                                    <t t-if="row.olib_boruvchi"> · olib boruvchi: <t t-esc="row.olib_boruvchi"/></t>
                                    <t t-if="row.izoh"> · <t t-esc="row.izoh"/></t>
                                </small>
                            </div>
                            <div class="fw-bold fs-5 text-nowrap">
                                <t t-esc="row.amount.toLocaleString('ru-RU')"/>
                                <t t-esc="row.symbol"/>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-success"
                                        t-att-disabled="state.saving"
                                        t-on-click="() => this.qabulQilish(row)">Qabul qildim</button>
                                <button class="btn btn-sm btn-outline-danger"
                                        t-att-disabled="state.saving"
                                        t-on-click="() => this.radEtish(row)">Rad etish</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================== KASSALAR ================== -->
                <div t-if="!state.kassalar.length" class="alert alert-warning">
                    Sizga kassa biriktirilmagan.
                    <strong>Kassa &#8594; Sozlamalar &#8594; Kassalar</strong> bo'limidan
                    kassa yarating yoki menejerdan o'zingizni kassirlar ro'yxatiga
                    qo'shishni so'rang.
                </div>

                <div class="row g-3 mb-3">
                    <div t-foreach="state.kassalar" t-as="k" t-key="k.id"
                         class="col-12 col-md-6 col-xl-4">
                        <div class="card sk-kassa rounded-3 shadow-sm h-100"
                             t-att-class="{'sk-kassa-active': k.id === state.kassaId}"
                             t-on-click="() => this.selectKassa(k.id)">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="fw-bold fs-5 text-truncate" t-esc="k.name"/>
                                    <span class="badge text-bg-secondary ms-auto" t-esc="k.currency"/>
                                </div>
                                <div class="text-muted small text-uppercase" t-esc="k.company"/>
                                <div class="sk-balance fw-bold"
                                     t-att-class="{'text-danger': k.balance &lt; 0}">
                                    <t t-esc="money(k.balance, k)"/>
                                </div>
                                <div t-if="k.transit" class="small text-warning fw-bold">
                                    Yo'lda: <t t-esc="money(k.transit, k)"/>
                                </div>
                                <div class="d-flex gap-3 mt-2 pt-2 border-top small">
                                    <div class="flex-fill">
                                        <div class="text-muted">Bugun kirim</div>
                                        <div class="fw-bold text-success" t-esc="money(k.kirim_today, k)"/>
                                    </div>
                                    <div class="flex-fill text-end">
                                        <div class="text-muted">Bugun chiqim</div>
                                        <div class="fw-bold text-danger" t-esc="money(k.chiqim_today, k)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================== TANLANGAN KASSA ================== -->
                <t t-if="state.day">
                    <div class="card rounded-3 shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                <span class="fw-bold fs-5" t-esc="state.day.date"/>
                                <span t-if="dayClosed" class="badge text-bg-secondary">Kun yopilgan</span>
                                <span t-else="" class="badge text-bg-success">Kun ochiq</span>
                                <div class="ms-auto d-flex gap-2 flex-wrap">
                                    <button class="btn btn-success fw-bold px-4"
                                            t-att-disabled="dayClosed"
                                            t-on-click="() => this.openForm('in')">
                                        &#11015;&#65039; KIRIM
                                    </button>
                                    <button class="btn btn-danger fw-bold px-4"
                                            t-att-disabled="dayClosed"
                                            t-on-click="() => this.openForm('out')">
                                        &#11014;&#65039; CHIQIM
                                    </button>
                                    <button class="btn btn-primary fw-bold px-4"
                                            t-if="canOtkazma"
                                            t-att-disabled="dayClosed"
                                            title="Boshqa kassaga pul jo'natish"
                                            t-on-click="() => this.openOtkazma('out')">
                                        &#8644; TRANSFER
                                    </button>
                                </div>
                            </div>
                            <div class="row g-2 text-center">
                                <div class="col-6 col-lg-3">
                                    <div class="sk-stat rounded-3 p-2">
                                        <div class="text-muted small">Kun boshida</div>
                                        <div class="fw-bold fs-5" t-esc="money(state.day.opening)"/>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-3">
                                    <div class="sk-stat sk-stat-in rounded-3 p-2">
                                        <div class="text-muted small">Kunlik kirim</div>
                                        <div class="fw-bold fs-5 text-success" t-esc="money(state.day.kirim)"/>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-3">
                                    <div class="sk-stat sk-stat-out rounded-3 p-2">
                                        <div class="text-muted small">Kunlik chiqim</div>
                                        <div class="fw-bold fs-5 text-danger" t-esc="money(state.day.chiqim)"/>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-3">
                                    <div class="sk-stat sk-stat-total rounded-3 p-2">
                                        <div class="text-muted small">Kun oxirida</div>
                                        <div class="fw-bold fs-5" t-esc="money(state.day.closing)"/>
                                    </div>
                                </div>
                            </div>
                            <div t-if="dayClosed and state.day.kun" class="mt-3 small">
                                <span class="text-muted">Sanab olindi:</span>
                                <strong t-esc="money(state.day.kun.sanoq)"/>
                                <span class="text-muted ms-3">Farq:</span>
                                <strong t-att-class="state.day.kun.farq ? 'text-danger' : 'text-success'"
                                        t-esc="money(state.day.kun.farq)"/>
                            </div>
                            <div t-if="!dayClosed and state.canClose" class="mt-3 text-end">
                                <button class="btn btn-outline-dark btn-sm" t-on-click="openClose">
                                    &#128274; Kunni yopish
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- ================== KUNLIK TARIX ================== -->
                    <div class="card rounded-3 shadow-sm">
                        <div class="card-header fw-bold">
                            Kun harakatlari
                            <span class="badge text-bg-secondary ms-2" t-esc="state.day.lines.length"/>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead>
                                    <tr class="text-muted small">
                                        <th style="width: 70px;">Vaqt</th>
                                        <th style="width: 90px;">Turi</th>
                                        <th>Modda</th>
                                        <th>Kim</th>
                                        <th>Izoh</th>
                                        <th class="text-end" style="width: 150px;">Summa</th>
                                        <th style="width: 80px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.day.lines" t-as="l" t-key="l.id"
                                        t-att-class="l.state === 'storno' ? 'text-muted text-decoration-line-through' : ''">
                                        <td class="text-nowrap" t-esc="formatTime(l.time)"/>
                                        <td>
                                            <span t-if="l.direction === 'in'"
                                                  class="badge text-bg-success">Kirim</span>
                                            <span t-else="" class="badge text-bg-danger">Chiqim</span>
                                        </td>
                                        <td class="sk-min0">
                                            <span t-esc="l.belgi" class="me-1"/>
                                            <span t-esc="l.modda"/>
                                        </td>
                                        <td class="sk-min0 text-truncate" t-esc="l.kim"/>
                                        <td class="sk-min0">
                                            <div class="text-truncate" t-esc="l.izoh"/>
                                            <small class="text-muted" t-esc="l.user"/>
                                        </td>
                                        <td class="text-end fw-bold text-nowrap"
                                            t-att-class="l.direction === 'in' ? 'text-success' : 'text-danger'">
                                            <t t-esc="(l.direction === 'in' ? '+' : '−') + ' ' + money(l.amount)"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <button t-if="l.chek_url"
                                                    class="btn btn-sm btn-outline-secondary py-0 px-1 me-1"
                                                    title="Chekni ochish"
                                                    t-on-click="() => this.openChek(l)">&#128196;</button>
                                            <button t-if="l.state === 'posted' and !l.auto and !dayClosed"
                                                    class="btn btn-sm btn-outline-danger py-0 px-1"
                                                    title="Storno"
                                                    t-on-click="() => this.stornoLine(l)">&#10005;</button>
                                        </td>
                                    </tr>
                                    <tr t-if="!state.day.lines.length">
                                        <td colspan="7" class="text-center text-muted py-4">
                                            Bu kunda harakat yo'q
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>

            <!-- ================== KIRIM/CHIQIM MODALI ================== -->
            <div t-if="state.showForm" class="sk-modal-backdrop" t-on-click="closeForm">
                <div class="sk-modal card rounded-3 shadow-lg" t-on-click.stop="">
                    <div class="card-header fw-bold fs-5"
                         t-att-class="state.form.direction === 'in' ? 'text-success' : 'text-danger'">
                        <t t-if="state.form.direction === 'in'">&#11015;&#65039; Kirim orderi</t>
                        <t t-else="">&#11014;&#65039; Chiqim orderi</t>
                        <button class="btn-close float-end" t-on-click="closeForm"/>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="sk-label">Summa</label>
                            <input type="number" step="0.01" min="0"
                                   class="form-control form-control-lg fw-bold"
                                   placeholder="0" t-model="state.form.amount"/>
                        </div>

                        <div class="mb-3">
                            <label class="sk-label">Modda</label>
                            <select class="form-select" t-model="state.form.moddaId"
                                    t-on-change="onModdaChange">
                                <option value="">— tanlang —</option>
                                <option t-foreach="moddalarForm" t-as="m" t-key="m.id"
                                        t-att-value="m.id" t-esc="m.name"/>
                            </select>
                        </div>

                        <div class="mb-3 position-relative">
                            <label class="sk-label">
                                <t t-if="depozitKerak">Depozit egasi (majburiy)</t>
                                <t t-elif="kontragentKerak">Kontragent (majburiy)</t>
                                <t t-else="">Kimdan / kimga (ixtiyoriy)</t>
                            </label>
                            <div class="btn-group btn-group-sm mb-2" role="group"
                                 t-if="!depozitKerak and !kontragentKerak">
                                <button class="btn"
                                        t-att-class="state.form.kimTur === 'partner' ? 'btn-primary' : 'btn-outline-primary'"
                                        t-on-click="() => this.setKimTur('partner')">Kontragent</button>
                                <button class="btn"
                                        t-att-class="state.form.kimTur === 'employee' ? 'btn-primary' : 'btn-outline-primary'"
                                        t-on-click="() => this.setKimTur('employee')">Xodim</button>
                                <button class="btn"
                                        t-att-class="state.form.kimTur === 'depozit' ? 'btn-primary' : 'btn-outline-primary'"
                                        t-on-click="() => this.setKimTur('depozit')">Depozit</button>
                            </div>
                            <input type="text" class="form-control"
                                   placeholder="Nom bo'yicha qidiring..."
                                   t-att-value="state.kimSearch"
                                   t-on-input="searchKim" t-on-focus="focusKim"/>
                            <div t-if="state.showKimList and state.kimResults.length"
                                 class="dropdown-menu show sk-dropdown w-100">
                                <a t-foreach="state.kimResults" t-as="r" t-key="r.id"
                                   class="dropdown-item" href="#"
                                   t-on-click.prevent="() => this.pickKim(r)">
                                    <span t-esc="r.name"/>
                                    <small t-if="r.balans !== undefined" class="text-muted ms-1">
                                        (qoldiq: <t t-esc="r.balans.toLocaleString('ru-RU')"/>)
                                    </small>
                                </a>
                            </div>
                        </div>

                        <div class="mb-3 position-relative" t-if="analitikKerak">
                            <label class="sk-label">Analitik kesim (majburiy)</label>
                            <input type="text" class="form-control"
                                   placeholder="Filial, seh yoki partiyani qidiring..."
                                   t-att-value="state.anaSearch"
                                   t-on-input="searchAna" t-on-focus="focusAna"/>
                            <div t-if="state.showAnaList and state.anaResults.length"
                                 class="dropdown-menu show sk-dropdown w-100">
                                <a t-foreach="state.anaResults" t-as="r" t-key="r.id"
                                   class="dropdown-item" href="#"
                                   t-on-click.prevent="() => this.pickAna(r)">
                                    <span t-esc="r.name"/>
                                    <small class="text-muted ms-1" t-esc="r.plan"/>
                                </a>
                            </div>
                            <div class="form-text">
                                Analitikasiz xarajat tannarxga tushmaydi — shuning
                                uchun bu modda uchun majburiy.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="sk-label">Izoh</label>
                            <textarea class="form-control" rows="3"
                                      placeholder="Pul nima uchun kirdi / chiqdi..."
                                      t-model="state.form.izoh"/>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary flex-fill" t-on-click="closeForm">Bekor</button>
                            <button class="btn flex-fill fw-bold"
                                    t-att-class="state.form.direction === 'in' ? 'btn-success' : 'btn-danger'"
                                    t-att-disabled="!formValid or state.saving"
                                    t-on-click="saveForm">Saqlash</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ================== TRANSFER MODALI ================== -->
            <div t-if="state.showOtkazma" class="sk-modal-backdrop" t-on-click="closeOtkazma">
                <div class="sk-modal card rounded-3 shadow-lg" t-on-click.stop="">
                    <div class="card-header fw-bold fs-5 text-primary">
                        &#8644; Kassalararo transfer
                        <button class="btn-close float-end" t-on-click="closeOtkazma"/>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="sk-label">Yo'nalish</label>
                            <div class="btn-group w-100" role="group">
                                <button class="btn"
                                        t-att-class="state.otkazma.yonalish === 'out' ? 'btn-primary' : 'btn-outline-primary'"
                                        t-on-click="() => this.setOtkazmaYonalish('out')">
                                    Bu kassadan chiqadi
                                </button>
                                <button class="btn"
                                        t-att-class="state.otkazma.yonalish === 'in' ? 'btn-primary' : 'btn-outline-primary'"
                                        t-on-click="() => this.setOtkazmaYonalish('in')">
                                    Bu kassaga keladi
                                </button>
                            </div>
                        </div>

                        <div class="sk-yol rounded-3 p-2 mb-3 d-flex align-items-center gap-2">
                            <div class="flex-fill sk-min0 text-center">
                                <div class="text-muted small text-uppercase">Kimdan</div>
                                <div class="fw-bold text-truncate" t-esc="otkazmaFrom ? otkazmaFrom.name : '—'"/>
                                <div class="small text-muted"
                                     t-esc="otkazmaFrom ? money(otkazmaFrom.balance, otkazmaFrom) : ''"/>
                            </div>
                            <div class="fs-3 text-primary">&#8594;</div>
                            <div class="flex-fill sk-min0 text-center">
                                <div class="text-muted small text-uppercase">Kimga</div>
                                <div class="fw-bold text-truncate" t-esc="otkazmaTo ? otkazmaTo.name : '—'"/>
                                <div class="small text-muted"
                                     t-esc="otkazmaTo ? money(otkazmaTo.balance, otkazmaTo) : ''"/>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="sk-label">
                                <t t-if="state.otkazma.yonalish === 'out'">Qaysi kassaga</t>
                                <t t-else="">Qaysi kassadan</t>
                            </label>
                            <select class="form-select" t-model="state.otkazma.boshqaId">
                                <option value="">— tanlang —</option>
                                <option t-foreach="otkazmaKassalar" t-as="k" t-key="k.id"
                                        t-att-value="k.id" t-esc="k.name"/>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="sk-label">Summa</label>
                            <input type="number" step="0.01" min="0"
                                   class="form-control form-control-lg fw-bold"
                                   placeholder="0" t-model="state.otkazma.amount"/>
                            <div t-if="otkazmaYetmaydi" class="text-danger small mt-1">
                                «<t t-esc="otkazmaFrom.name"/>» kassasida shuncha pul yo'q
                                (bor: <t t-esc="money(otkazmaFrom.balance, otkazmaFrom)"/>).
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="sk-label">Izoh (ixtiyoriy)</label>
                            <textarea class="form-control" rows="2"
                                      placeholder="Kim olib boradi, nima uchun jo'natilyapti..."
                                      t-model="state.otkazma.izoh"/>
                        </div>

                        <div class="alert alert-light border py-2 small mb-3">
                            Pul «<t t-esc="otkazmaFrom ? otkazmaFrom.name : '—'"/>» dan darhol
                            chiqadi, lekin «<t t-esc="otkazmaTo ? otkazmaTo.name : '—'"/>» ga
                            <strong>faqat qabul qilingandan keyin</strong> kiradi. Oraliqda u
                            «Yo'ldagi pul» hisobida turadi.
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary flex-fill" t-on-click="closeOtkazma">Bekor</button>
                            <button class="btn btn-primary flex-fill fw-bold"
                                    t-att-disabled="!otkazmaValid or state.saving"
                                    t-on-click="saveOtkazma">Jo'natish</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ================== KUNNI YOPISH MODALI ================== -->
            <div t-if="state.showClose" class="sk-modal-backdrop" t-on-click="hideClose">
                <div class="sk-modal card rounded-3 shadow-lg" t-on-click.stop="">
                    <div class="card-header fw-bold fs-5">
                        &#128274; Kunni yopish — <t t-esc="state.date"/>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-light border">
                            Hisob bo'yicha kassada bo'lishi kerak:
                            <strong class="fs-5" t-esc="money(state.day.closing)"/>
                        </div>
                        <div class="mb-3">
                            <label class="sk-label">Sanab olingan naqd pul</label>
                            <input type="number" step="0.01"
                                   class="form-control form-control-lg fw-bold"
                                   t-model="state.closeForm.sanoq"/>
                        </div>
                        <div class="mb-3">
                            <label class="sk-label">Farq</label>
                            <div class="fs-4 fw-bold"
                                 t-att-class="closeFarq ? 'text-danger' : 'text-success'"
                                 t-esc="money(closeFarq)"/>
                        </div>
                        <div class="mb-3">
                            <label class="sk-label">Izoh</label>
                            <textarea class="form-control" rows="2"
                                      placeholder="Farq sababi, eslatma..."
                                      t-model="state.closeForm.note"/>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary flex-fill" t-on-click="hideClose">Bekor</button>
                            <button class="btn btn-dark flex-fill fw-bold"
                                    t-att-disabled="state.saving"
                                    t-on-click="confirmClose">Kunni yopish</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</t>

</templates>
