<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_ink" model="ir.module.category">
            <field name="name">AgroNova — Inkubatoriya</field>
            <field name="sequence">46</field>
        </record>

        <record id="res_groups_privilege_ink" model="res.groups.privilege">
            <field name="name">AgroNova — Inkubatoriya</field>
            <field name="category_id" ref="module_category_ink"/>
            <field name="sequence">46</field>
        </record>

        <!-- TZ 12-band: to'rt rol -->
        <record id="group_ink_omborchi" model="res.groups">
            <field name="name">Omborchi</field>
            <field name="privilege_id" ref="res_groups_privilege_ink"/>
            <field name="sequence">5</field>
            <field name="comment">Tuxum kirimi, jo'ja kirimi, ichki ko'chirish.</field>
        </record>

        <record id="group_ink_operator" model="res.groups">
            <field name="name">Operator</field>
            <field name="privilege_id" ref="res_groups_privilege_ink"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('group_ink_omborchi'))]"/>
            <field name="comment">Tuxum qabuli, inkubatsiya partiyasi, ochilish natijasi.</field>
        </record>

        <record id="group_ink_boshliq" model="res.groups">
            <field name="name">Bo'lim boshlig'i</field>
            <field name="privilege_id" ref="res_groups_privilege_ink"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_ink_operator'))]"/>
            <field name="comment">Partiya yakunlash, jo'jani ichki berish, hisobotlar.</field>
        </record>

        <record id="group_ink_hisobchi" model="res.groups">
            <field name="name">Hisobchi</field>
            <field name="privilege_id" ref="res_groups_privilege_ink"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_ink_boshliq'))]"/>
            <field name="comment">Tannarx, xarajat, elminatsiya, moliyaviy hisobotlar.</field>
        </record>

    </data>
</odoo>
