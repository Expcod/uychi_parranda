<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Ko'p korxonali muhitda har bo'lim faqat o'z yozuvini ko'radi.
             Inkubatoriya bitta korxona bo'lsa ham qoida qoladi: keyin
             ikkinchi inkubatoriya ochilsa tayyor turadi. -->

        <record id="rule_ink_inkubator_company" model="ir.rule">
            <field name="name">Inkubator — o'z korxonasi</field>
            <field name="model_id" ref="model_agronova_ink_inkubator"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

