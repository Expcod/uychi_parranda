<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agronova_telegram_log_list" model="ir.ui.view">
        <field name="name">agronova.telegram.log.list</field>
        <field name="model">agronova.telegram.log</field>
        <field name="arch" type="xml">
            <list string="Telegram jurnali" decoration-danger="not success" create="0">
                <field name="create_date" string="Vaqti"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="trip_id"/>
                <field name="expense_id" optional="show"/>
                <field name="chat_id" optional="hide"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_agronova_telegram_log_search" model="ir.ui.view">
        <field name="name">agronova.telegram.log.search</field>
        <field name="model">agronova.telegram.log</field>
        <field name="arch" type="xml">
            <search string="Telegram jurnali">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="trip_id"/>
                <filter name="failed" string="Xatolar" domain="[('success', '=', False)]"/>
                <group>
                    <filter name="g_employee" string="Xodim" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_name" string="Amal" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agronova_telegram_log" model="ir.actions.act_window">
        <field name="name">Telegram jurnali</field>
        <field name="res_model">agronova.telegram.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_agronova_telegram_log_search"/>
    </record>

    <menuitem id="menu_agronova_telegram_log"
              name="Telegram jurnali"
              parent="fleet.menu_root"
              action="action_agronova_telegram_log"
              sequence="90"
              groups="hr.group_hr_user"/>

</odoo>
