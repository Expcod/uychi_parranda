<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Transfer formasi: skanerlash tugmasi va holat -->
    <record id="view_picking_form_qr_scan" model="ir.ui.view">
        <field name="name">stock.picking.form.qr.scan</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="qr_scan_required" invisible="1"/>
                <field name="qr_scan_done" invisible="1"/>
                <field name="qr_scan_bypassed" invisible="1"/>
                <!-- Skanerlash shu oyna ichida bo'ladi. Skanerlash tugagach
                     tugma ko'rinishi o'zgaradi, lekin oyna baribir ochiladi —
                     omborchi nimalar skanerlanganini ko'rishi kerak. -->
                <button name="action_open_qr_scan" type="object"
                        string="Skanerlashni boshlash" icon="fa-qrcode"
                        class="btn-primary"
                        invisible="not qr_scan_required or state in ('done', 'cancel') or qr_scan_done or qr_scan_bypassed"/>
                <button name="action_open_qr_scan" type="object"
                        string="Skanerlanganlar" icon="fa-list-ul"
                        invisible="not qr_scan_required or state in ('done', 'cancel') or not qr_scan_done or qr_scan_bypassed"/>
                <button name="action_bypass_qr_scan" type="object"
                        string="Skanerlashsiz o'tkazish" icon="fa-exclamation-triangle"
                        groups="stock.group_stock_manager"
                        confirm="Skanerlashni chetlab o'tmoqchimisiz? Sabab yozishingiz kerak."
                        invisible="not qr_scan_required or state in ('done', 'cancel') or qr_scan_done or qr_scan_bypassed"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="status"
                     invisible="not qr_scan_required or state in ('done', 'cancel') or qr_scan_done or qr_scan_bypassed">
                    <i class="fa fa-qrcode me-2" role="img" aria-hidden="true" title="QR"/>
                    <b>QR skanerlash kerak</b> —
                    <field name="qr_scan_info" readonly="1" class="oe_inline"/>.
                    "Skanerlashni boshlash" tugmasini bosing va QR kodlarni skanerlang.
                </div>
                <div class="alert alert-success mb-0" role="status"
                     invisible="not qr_scan_required or state in ('done', 'cancel') or not qr_scan_done or qr_scan_bypassed">
                    <i class="fa fa-check-circle me-2" role="img" aria-hidden="true" title="Tayyor"/>
                    <b>Skanerlash yakunlandi</b> —
                    <field name="qr_scan_info" readonly="1" class="oe_inline"/>.
                    Transferni tasdiqlashingiz mumkin.
                </div>
                <div class="alert alert-warning mb-0" role="status"
                     invisible="not qr_scan_bypassed">
                    <i class="fa fa-exclamation-triangle me-2" role="img" aria-hidden="true" title="Diqqat"/>
                    <b>Skanerlash chetlab o'tilgan</b> — sabab xabarlar tarixida yozilgan.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Skanerlash oynasi -->
    <record id="view_picking_qr_scan_form" model="ir.ui.view">
        <field name="name">agronova.picking.qr.scan.form</field>
        <field name="model">agronova.picking.qr.scan</field>
        <field name="arch" type="xml">
            <form string="QR skanerlash">
                <field name="picking_id" invisible="1"/>
                <field name="is_done" invisible="1"/>
                <field name="last_status" invisible="1"/>
                <field name="box_count" invisible="1"/>

                <div class="alert alert-success" role="status" invisible="not is_done">
                    <i class="fa fa-check-circle me-2" role="img" aria-hidden="true" title="Tayyor"/>
                    <b>Tayyor!</b> Barcha mahsulotlar skanerlandi — oynani yopib
                    transferni tasdiqlashingiz mumkin.
                </div>

                <group>
                    <group>
                        <!-- Kursor shu yerda turadi. Skaner klaviatura kabi
                             yozadi va oxirida Enter yuboradi — `onchange` shu
                             paytda ishga tushib kodni qayta ishlaydi. -->
                        <field name="scan_code" placeholder="QR kodni skanerlang..."
                               widget="char" autofocus="autofocus"/>
                    </group>
                    <group>
                        <field name="progress_info" readonly="1"/>
                        <field name="scanned_qty" invisible="1"/>
                        <field name="demand_qty" invisible="1"/>
                    </group>
                </group>

                <div class="alert alert-danger" role="alert"
                     invisible="last_status != 'fifo_block'"
                     style="white-space: pre-line;">
                    <i class="fa fa-ban me-2" role="img" aria-hidden="true" title="Taqiqlangan"/>
                    <b>FIFO buzilish!</b>
                    <field name="last_message" readonly="1" nolabel="1"
                           class="d-block mt-1"/>
                </div>
                <div class="alert alert-secondary" role="status"
                     invisible="not last_message or last_status == 'fifo_block'">
                    <field name="last_message" readonly="1" nolabel="1"/>
                </div>

                <notebook>
                    <!-- Asosiy ko'rinish: omborchi qaysi mahsulotdan yana
                         nechta kerakligini bir qarashda ko'radi. -->
                    <page string="Mahsulotlar" name="products">
                        <field name="product_line_ids" readonly="1" nolabel="1">
                            <list create="0" delete="0" edit="0"
                                  decoration-success="is_complete"
                                  decoration-muted="is_complete">
                                <field name="is_complete" column_invisible="1"/>
                                <field name="product_id"/>
                                <field name="scanned_qty" string="Skanerlangan"
                                       sum="Jami"/>
                                <field name="demand_qty" string="So'ralgan"
                                       sum="Jami"/>
                                <field name="remaining_qty" string="Qolgan"
                                       decoration-danger="remaining_qty &gt; 0"
                                       decoration-bf="remaining_qty &gt; 0"/>
                            </list>
                        </field>
                    </page>

                    <page string="Seriyalar" name="serials">
                        <field name="line_ids" readonly="1" nolabel="1">
                            <list create="0" delete="0" edit="0">
                                <field name="product_id"/>
                                <field name="lot_id" string="Seriya raqami"/>
                                <field name="qr_box_id" string="Quti"
                                       optional="show"/>
                                <field name="quantity" string="Miqdor"/>
                            </list>
                        </field>
                    </page>

                    <!-- Quti skanerlanmagan bo'lsa tab keraksiz — yashiramiz. -->
                    <page string="Qutilar" name="boxes" invisible="not box_count">
                        <field name="box_ids" readonly="1" nolabel="1">
                            <list create="0" delete="0" edit="0">
                                <field name="name" string="Quti kodi"/>
                                <field name="product_id"/>
                                <field name="lot_count" string="Ichidagi soni"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <footer>
                    <button name="action_done" type="object" string="Yopish"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Chetlab o'tish oynasi -->
    <record id="view_picking_qr_bypass_form" model="ir.ui.view">
        <field name="name">agronova.picking.qr.bypass.form</field>
        <field name="model">agronova.picking.qr.bypass</field>
        <field name="arch" type="xml">
            <form string="Skanerlashni chetlab o'tish">
                <field name="picking_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <i class="fa fa-exclamation-triangle me-2" role="img" aria-hidden="true" title="Diqqat"/>
                    Skanerlashsiz o'tkazish faqat zarurat bo'lganda ishlatiladi
                    (eski mahsulot, yirtilgan stiker). Sabab transfer tarixida saqlanadi.
                </div>
                <group>
                    <field name="reason" nolabel="1" colspan="2"
                           placeholder="Masalan: eski partiya, QR stikeri yo'q..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Tasdiqlash" class="btn-primary"/>
                    <button string="Bekor qilish" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
